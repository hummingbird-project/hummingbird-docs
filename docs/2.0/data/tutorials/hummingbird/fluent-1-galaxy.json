,{"type":"text","text":" are used to define the server bind address, "},{"type":"codeVoice","code":"logLevel"},{"type":"text","text":" sets the level of logging required. Finally the "},{"type":"codeVoice","code":"run()"},{"type":"text","text":" function which calls "},{"type":"codeVoice","code":"buildApplication(_:)"},{"type":"text","text":" to create an "},{"type":"codeVoice","code":"Application"},{"type":"text","text":" and then runs it using "},{"type":"codeVoice","code":"runService()"},{"type":"text","text":". You can find out more about the argument parser library "},{"type":"reference","isActive":true,"identifier":"https:\/\/apple.github.io\/swift-argument-parser\/documentation\/argumentparser"},{"type":"text","text":"."}]}],"code":"fluent-universe-07.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Open ","type":"text"},{"code":"Sources\/App\/App.swift","type":"codeVoice"}]}],"runtimePreview":null,"media":null,"type":"step"},{"caption":[],"code":"fluent-universe-08.swift","content":[{"inlineContent":[{"text":"Add the new app arguments with default values.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"media":null,"type":"step"},{"caption":[{"type":"paragraph","inlineContent":[{"text":"We can now add Fluent to our application’s lifecycle.","type":"text"}]}],"code":"fluent-universe-06.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Open ","type":"text"},{"type":"codeVoice","code":"Sources\/App\/Application+build.swift"},{"text":" again.","type":"text"}]}],"runtimePreview":null,"media":null,"type":"step"},{"caption":[{"inlineContent":[{"type":"text","text":"Depending on the "},{"type":"codeVoice","code":"inMemoryDatabase"},{"type":"text","text":" boolean, this application can run completely in-memory. This is useful for testing, as it loses all data when the application is re-launched."}],"type":"paragraph"}],"code":"fluent-universe-09.swift","content":[{"inlineContent":[{"text":"First, create a Fluent object and add the SQLite driver to Fluent.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"media":null,"type":"step"},{"caption":[{"type":"paragraph","inlineContent":[{"text":"This allows it to integrate with Hummingbird’s ecosystem, including the Auth framework.","type":"text"}]}],"code":"fluent-universe-10.swift","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Next, we’ll use Fluent as a persistence mechanism for the Persist framework. This step is "},{"type":"strong","inlineContent":[{"type":"text","text":"optional"}]},{"type":"text","text":" for this tutorial."}]}],"runtimePreview":null,"media":null,"type":"step"},{"caption":[],"code":"fluent-universe-11.swift","content":[{"type":"paragraph","inlineContent":[{"text":"Finally, both Fluent and the FluentPersistDriver are added to swift-service-lifecycle.","type":"text"}]}],"runtimePreview":null,"media":null,"type":"step"}],"title":"Add Fluent","contentSection":[{"content":[{"inlineContent":[{"type":"text","text":"With your Package.swift set up, lets add Fluent to your project."}],"type":"paragraph"}],"kind":"contentAndMedia","mediaPosition":"trailing","media":"hummingbird.png"}],"anchor":"Add-Fluent"},{"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a file named "},{"type":"codeVoice","code":"Galaxy.swift"},{"type":"text","text":", and add the following Fluent Model."}]}],"media":null,"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This Fluent model has the ‘id’ and a ‘name’ properties."}]}],"code":"fluent-universe-12.swift","type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Before being able to use a Model, a migration must be added.","type":"text"}]}],"media":null,"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A migration creates or reverts a diff to the schema in the database."}]}],"code":"fluent-universe-13.swift","type":"step"},{"content":[{"inlineContent":[{"text":"Open ","type":"text"},{"code":"Sources\/App\/Application+build.swift","type":"codeVoice"},{"text":" again. Fluent is now a completely blank slate, let’s set it up.","type":"text"}],"type":"paragraph"}],"media":null,"runtimePreview":null,"caption":[{"inlineContent":[{"text":"The newly added migrations are added to Fluent. Make sure that any new migrations are added to Fluent in the right order.","type":"text"}],"type":"paragraph"}],"code":"fluent-universe-14.swift","type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The final step to set up Fluent is to run the migrations."}]}],"media":null,"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It’s common to explicitly run migrations, but for small scale set-ups can also run migrations on every app launch."}]}],"code":"fluent-universe-15.swift","type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If we look further down the file we can find the "},{"type":"codeVoice","code":"buildRouter()"},{"type":"text","text":" function."}]}],"media":null,"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"Here we create the ","type":"text"},{"code":"Router","type":"codeVoice"},{"text":". We add a logging middleware to it (this logs all requests to the router). The function uses a result builder to create a stack of middleware, but you can also use ","type":"text"},{"code":"Router.add(middleware:)","type":"codeVoice"},{"text":" to add individual middleware. Finally we add a single endpoint GET ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" which returns “Hello!”","type":"text"}]}],"code":"fluent-universe-15.swift","type":"step"},{"content":[{"inlineContent":[{"text":"We’ll add a single route ","type":"text"},{"type":"codeVoice","code":"GET \/galaxies"},{"text":", which lists all registered galaxies.","type":"text"}],"type":"paragraph"}],"media":null,"runtimePreview":null,"caption":[{"inlineContent":[{"type":"text","text":"Because the database is empty now, we’ll add a route "},{"type":"codeVoice","code":"PUT \/galaxies"},{"type":"text","text":" to add your own galaxies."}],"type":"paragraph"}],"code":"fluent-universe-16.swift","type":"step"}],"title":"Add Galaxy API","contentSection":[{"kind":"contentAndMedia","media":"hummingbird.png","mediaPosition":"trailing","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add your database models and routes to edit them."}]}]}],"anchor":"Add-Galaxy-API"},{"stepsSection":[{"type":"step","runtimePreview":null,"caption":[{"inlineContent":[{"type":"text","text":"First, create your own galaxy!"}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"We can run the application and use curl to test it works."}],"type":"paragraph"}],"media":null,"code":"fluent-universe-17.sh"},{"type":"step","runtimePreview":null,"caption":[],"content":[{"inlineContent":[{"type":"text","text":"Then, query the list of galaxies."}],"type":"paragraph"}],"media":null,"code":"fluent-universe-18.sh"},{"type":"step","runtimePreview":null,"caption":[],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can see the galaxy added in the first call, is returned when we ask to list all the galaxies."}]}],"media":null,"code":"fluent-universe-19.sh"}],"title":"Test your Backend","contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Now that your Fluent backend is complete, it’s time to validate the results!","type":"text"}]}],"media":"hummingbird.png"}],"anchor":"Test-your-Backend"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Fluent-1-Galaxy"},"references":{"fluent-universe-07.swift":{"content":["import ArgumentParser","import Hummingbird","import Logging","","@main","struct App: AsyncParsableCommand, AppArguments {","    @Option(name: .shortAndLong)","    var hostname: String = \"127.0.0.1\"","","    @Option(name: .shortAndLong)","    var port: Int = 8080","","    @Option(name: .shortAndLong)","    var logLevel: Logger.Level?","","    func run() async throws {","        let app = try await buildApplication(self)","        try await app.runService()","    }","}","","\/\/\/ Extend `Logger.Level` so it can be used as an argument","#if hasFeature(RetroactiveAttribute)","    extension Logger.Level: @retroactive ExpressibleByArgument {}","#else","    extension Logger.Level: ExpressibleByArgument {}","#endif"],"fileName":"Sources\/App\/App.swift","fileType":"swift","syntax":"swift","type":"file","highlights":[],"identifier":"fluent-universe-07.swift"},"fluent-universe-10.swift":{"fileType":"swift","fileName":"Sources\/App\/Application+build.swift","highlights":[{"line":43},{"line":44}],"syntax":"swift","type":"file","identifier":"fluent-universe-10.swift","content":["import Hummingbird","import Logging","import FluentSQLiteDriver","import Foundation","import HummingbirdFluent","","\/\/\/ Application arguments protocol. We use a protocol so we can call","\/\/\/ `buildApplication` inside Tests as well as in the App executable.","\/\/\/ Any variables added here also have to be added to `App` in App.swift and","\/\/\/ `TestArguments` in AppTest.swift","public protocol AppArguments {","    var inMemoryDatabase: Bool { get }","    var migrate: Bool { get }","    var hostname: String { get }","    var port: Int { get }","    var logLevel: Logger.Level? { get }","}","","\/\/ Request context used by application","typealias AppRequestContext = BasicRequestContext","","\/\/\/  Build application","\/\/\/ - Parameter arguments: application arguments","public func buildApplication(_ arguments: some AppArguments) async throws -> some ApplicationProtocol {","    let environment = Environment()","    let logger = {","        var logger = Logger(label: \"TodosFluent\")","        logger.logLevel =","        arguments.logLevel ??","        environment.get(\"LOG_LEVEL\").flatMap { Logger.Level(rawValue: $0) } ??","            .info","        return logger","    }()","","    let fluent = Fluent(logger: logger)","    \/\/ add sqlite database","    if arguments.inMemoryDatabase {","        fluent.databases.use(.sqlite(.memory), as: .sqlite)","    } else {","        fluent.databases.use(.sqlite(.file(\"db.sqlite\")), as: .sqlite)","    }","","    let fluentPersist = await FluentPersistDriver(fluent: fluent)","    ","    let router = buildRouter()","    let app = Application(","        router: router,","        configuration: .init(","            address: .hostname(arguments.hostname, port: arguments.port),","            serverName: \"TodosFluent\"","        ),","        logger: logger","    )","    return app","}","","\/\/\/ Build router","func buildRouter() -> Router<AppRequestContext> {","    let router = Router(context: AppRequestContext.self)","    \/\/ Add middleware","    router.addMiddleware {","        \/\/ logging middleware","        LogRequestsMiddleware(.info)","    }","    \/\/ Add default endpoint","    router.get(\"\/\") { _,_ in","        return \"Hello!\"","    }","    return router","}"]},"fluent-universe-15.swift":{"content":["import Hummingbird","import Logging","import FluentSQLiteDriver","import Foundation","import HummingbirdFluent","","\/\/\/ Application arguments protocol. We use a protocol so we can call","\/\/\/ `buildApplication` inside Tests as well as in the App executable.","\/\/\/ Any variables added here also have to be added to `App` in App.swift and","\/\/\/ `TestArguments` in AppTest.swift","public protocol AppArguments {","    var inMemoryDatabase: Bool { get }","    var migrate: Bool { get }","    var hostname: String { get }","    var port: Int { get }","    var logLevel: Logger.Level? { get }","}","","\/\/ Request context used by application","typealias AppRequestContext = BasicRequestContext","","\/\/\/  Build application","\/\/\/ - Parameter arguments: application arguments","public func buildApplication(_ arguments: some AppArguments) async throws -> some ApplicationProtocol {","    let environment = Environment()","    let logger = {","        var logger = Logger(label: \"TodosFluent\")","        logger.logLevel =","        arguments.logLevel ??","        environment.get(\"LOG_LEVEL\").flatMap { Logger.Level(rawValue: $0) } ??","            .info","        return logger","    }()","","    let fluent = Fluent(logger: logger)","    \/\/ add sqlite database","    if arguments.inMemoryDatabase {","        fluent.databases.use(.sqlite(.memory), as: .sqlite)","    } else {","        fluent.databases.use(.sqlite(.file(\"db.sqlite\")), as: .sqlite)","    }","    \/\/ add migrations","    await fluent.migrations.add(CreateGalaxy())","","    let fluentPersist = await FluentPersistDriver(fluent: fluent)","","    \/\/ migrate","    if arguments.migrate || arguments.inMemoryDatabase {","        try await fluent.migrate()","    }","","    let router = buildRouter()","    var app = Application(","        router: router,","        configuration: .init(","            address: .hostname(arguments.hostname, port: arguments.port),","            serverName: \"TodosFluent\"","        ),","        logger: logger","    )","    app.addServices(fluent, fluentPersist)","    return app","}","","\/\/\/ Build router","func buildRouter() -> Router<AppRequestContext> {","    let router = Router(context: AppRequestContext.self)","    \/\/ Add middleware","    router.addMiddleware {","        \/\/ logging middleware","        LogRequestsMiddleware(.info)","    }","    \/\/ Add default endpoint","    router.get(\"\/\") { _,_ in","        return \"Hello!\"","    }","    return router","}"],"fileName":"Sources\/App\/Application+build.swift","fileType":"swift","syntax":"swift","type":"file","highlights":[],"identifier":"fluent-universe-15.swift"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Fluent-1-Galaxy#Test-your-Backend":{"role":"pseudoSymbol","title":"Test your Backend","type":"section","abstract":[{"text":"Create a simple web application using the Hummingbird template.","type":"text"}],"kind":"section","url":"\/tutorials\/hummingbird\/fluent-1-galaxy#Test-your-Backend","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Fluent-1-Galaxy#Test-your-Backend"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Fluent-1-Galaxy#Add-Galaxy-API":{"url":"\/tutorials\/hummingbird\/fluent-1-galaxy#Add-Galaxy-API","kind":"section","title":"Add Galaxy API","role":"pseudoSymbol","abstract":[{"type":"text","text":"Create a simple web application using the Hummingbird template."}],"type":"section","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Fluent-1-Galaxy#Add-Galaxy-API"},"https://apple.github.io/swift-argument-parser/documentation/argumentparser":{"title":"here","identifier":"https:\/\/apple.github.io\/swift-argument-parser\/documentation\/argumentparser","url":"https:\/\/apple.github.io\/swift-argument-parser\/documentation\/argumentparser","type":"link","titleInlineContent":[{"text":"here","type":"text"}]},"fluent-universe-19.sh":{"fileType":"","fileName":"Test Application","highlights":[{"line":2},{"line":3},{"line":4},{"line":5},{"line":6},{"line":7},{"line":8}],"syntax":"","type":"file","identifier":"fluent-universe-19.sh","content":["> curl -i localhost:8080\/galaxies","HTTP\/1.1 200 OK","Content-Type: application\/json; charset=utf-8","Content-Length: 66","Date: Thu, 21 Nov 2024 14:55:26 GMT","Server: TodosFluent","","[{\"id\":\"9DB14C0C-EC2E-4C51-84CB-A2BEB4CDF967\",\"name\":\"Andromeda\"}]"]},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Fluent-1-Galaxy#Add-Fluent":{"url":"\/tutorials\/hummingbird\/fluent-1-galaxy#Add-Fluent","title":"Add Fluent","kind":"section","role":"pseudoSymbol","abstract":[{"text":"Create a simple web application using the Hummingbird template.","type":"text"}],"type":"section","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Fluent-1-Galaxy#Add-Fluent"},"fluent-universe-02.sh":{"fileType":"","fileName":"Create Swift Package","highlights":[],"syntax":"","type":"file","identifier":"fluent-universe-02.sh","content":["> .\/template\/configure.sh TodosFluent","Enter your package name: [TodosFluent] > ","Enter your executable name: [App] > ","Include Visual Studio Code snippets: [Y\/n] > "]},"fluent-universe-04.swift":{"content":["\/\/ swift-tools-version:6.0","\/\/ The swift-tools-version declares the minimum version of Swift required to build this package.","","import PackageDescription","","let package = Package(","    name: \"TodosFluent\",","    platforms: [.macOS(.v14), .iOS(.v17), .tvOS(.v17)],","    products: [","        .executable(name: \"App\", targets: [\"App\"]),","    ],","    dependencies: [","        .package(url: \"https:\/\/github.com\/hummingbird-project\/hummingbird.git\", from: \"2.0.0\"),","        .package(url: \"https:\/\/github.com\/apple\/swift-argument-parser.git\", from: \"1.3.0\"),","        .package(url: \"https:\/\/github.com\/hummingbird-project\/hummingbird-fluent.git\", from: \"2.0.0-beta.5\"),","        .package(url: \"https:\/\/github.com\/vapor\/fluent-sqlite-driver.git\", from: \"4.7.0\"),","    ],","    targets: [","        .executableTarget(","            name: \"App\",","            dependencies: [","                .product(name: \"ArgumentParser\", package: \"swift-argument-parser\"),","                .product(name: \"FluentSQLiteDriver\", package: \"fluent-sqlite-driver\"),","                .product(name: \"Hummingbird\", package: \"hummingbird\"),","                .product(name: \"HummingbirdFluent\", package: \"hummingbird-fluent\"),","            ],","            path: \"Sources\/App\"","        ),","        .testTarget(","            name: \"AppTests\",","            dependencies: [","                .byName(name: \"App\"),","                .product(name: \"HummingbirdTesting\", package: \"hummingbird\")","            ],","            path: \"Tests\/AppTests\"","        )","    ]",")"],"fileName":"Package.swift","fileType":"swift","syntax":"swift","type":"file","highlights":[{"line":15},{"line":16},{"line":23},{"line":25}],"identifier":"fluent-universe-04.swift"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Fluent-1-Galaxy":{"role":"project","title":"Create a Hummingbird + Fluent application.","estimatedTime":"15min","type":"topic","kind":"project","abstract":[{"type":"text","text":"Create a simple web application using the Hummingbird template."}],"url":"\/tutorials\/hummingbird\/fluent-1-galaxy","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Fluent-1-Galaxy"},"fluent-universe-16.swift":{"fileName":"Sources\/App\/Application+build.swift","content":["import Hummingbird","import Logging","import FluentSQLiteDriver","import Foundation","import HummingbirdFluent","","\/\/\/ Application arguments protocol. We use a protocol so we can call","\/\/\/ `buildApplication` inside Tests as well as in the App executable.","\/\/\/ Any variables added here also have to be added to `App` in App.swift and","\/\/\/ `TestArguments` in AppTest.swift","public protocol AppArguments {","    var inMemoryDatabase: Bool { get }","    var migrate: Bool { get }","    var hostname: String { get }","    var port: Int { get }","    var logLevel: Logger.Level? { get }","}","","\/\/ Request context used by application","typealias AppRequestContext = BasicRequestContext","","\/\/\/  Build application","\/\/\/ - Parameter arguments: application arguments","public func buildApplication(_ arguments: some AppArguments) async throws -> some ApplicationProtocol {","    let environment = Environment()","    let logger = {","        var logger = Logger(label: \"TodosFluent\")","        logger.logLevel =","        arguments.logLevel ??","        environment.get(\"LOG_LEVEL\").flatMap { Logger.Level(rawValue: $0) } ??","            .info","        return logger","    }()","","    let fluent = Fluent(logger: logger)","    \/\/ add sqlite database","    if arguments.inMemoryDatabase {","        fluent.databases.use(.sqlite(.memory), as: .sqlite)","    } else {","        fluent.databases.use(.sqlite(.file(\"db.sqlite\")), as: .sqlite)","    }","    \/\/ add migrations","    await fluent.migrations.add(CreateGalaxy())","","    let fluentPersist = await FluentPersistDriver(fluent: fluent)","","    \/\/ migrate","    if arguments.migrate || arguments.inMemoryDatabase {","        try await fluent.migrate()","    }","","    let router = buildRouter(fluent: fluent)","    var app = Application(","        router: router,","        configuration: .init(","            address: .hostname(arguments.hostname, port: arguments.port),","            serverName: \"TodosFluent\"","        ),","        logger: logger","    )","    app.addServices(fluent, fluentPersist)","    return app","}","","\/\/\/ Build router","func buildRouter(fluent: Fluent) -> Router<AppRequestContext> {","    let router = Router(context: AppRequestContext.self)","    \/\/ Add middleware","    router.addMiddleware {","        \/\/ logging middleware","        LogRequestsMiddleware(.info)","    }","    \/\/ Add default endpoint","    router.get(\"\/\") { _,_ in","        return \"Hello!\"","    }","    \/\/ List all galaxies","    router.get(\"\/galaxies\") { _,_ -> [Galaxy] in","        try await Galaxy.query(on: self.fluent.db()).all()","    }","    router.put(\"\/galaxies\") { request, context -> Response in","        let galaxy = try await request.decode(as: Galaxy.self, context: context)","        try await galaxy.save(on: fluent.db())","        return Response(status: .created)","    }","    return router","}"],"fileType":"swift","syntax":"swift","type":"file","highlights":[{"line":52},{"line":66},{"line":76},{"line":77},{"line":78},{"line":79},{"line":80},{"line":81},{"line":82},{"line":83},{"line":84}],"identifier":"fluent-universe-16.swift"},"fluent-universe-11.swift":{"fileType":"swift","fileName":"Sources\/App\/Application+build.swift","highlights":[{"line":46},{"line":54}],"syntax":"swift","type":"file","identifier":"fluent-universe-11.swift","content":["import Hummingbird","import Logging","import FluentSQLiteDriver","import Foundation","import HummingbirdFluent","","\/\/\/ Application arguments protocol. We use a protocol so we can call","\/\/\/ `buildApplication` inside Tests as well as in the App executable.","\/\/\/ Any variables added here also have to be added to `App` in App.swift and","\/\/\/ `TestArguments` in AppTest.swift","public protocol AppArguments {","    var inMemoryDatabase: Bool { get }","    var migrate: Bool { get }","    var hostname: String { get }","    var port: Int { get }","    var logLevel: Logger.Level? { get }","}","","\/\/ Request context used by application","typealias AppRequestContext = BasicRequestContext","","\/\/\/  Build application","\/\/\/ - Parameter arguments: application arguments","public func buildApplication(_ arguments: some AppArguments) async throws -> some ApplicationProtocol {","    let environment = Environment()","    let logger = {","        var logger = Logger(label: \"TodosFluent\")","        logger.logLevel =","        arguments.logLevel ??","        environment.get(\"LOG_LEVEL\").flatMap { Logger.Level(rawValue: $0) } ??","            .info","        return logger","    }()","","    let fluent = Fluent(logger: logger)","    \/\/ add sqlite database","    if arguments.inMemoryDatabase {","        fluent.databases.use(.sqlite(.memory), as: .sqlite)","    } else {","        fluent.databases.use(.sqlite(.file(\"db.sqlite\")), as: .sqlite)","    }","","    let fluentPersist = await FluentPersistDriver(fluent: fluent)","    ","    let router = buildRouter()","    var app = Application(","        router: router,","        configuration: .init(","            address: .hostname(ar