text":" are used to define the server bind address, ","type":"text"},{"code":"logLevel","type":"codeVoice"},{"text":" sets the level of logging required. Finally the ","type":"text"},{"code":"run()","type":"codeVoice"},{"text":" function which calls ","type":"text"},{"code":"buildApplication(_:)","type":"codeVoice"},{"text":" to create an ","type":"text"},{"code":"Application","type":"codeVoice"},{"text":" and then runs it using ","type":"text"},{"code":"runService()","type":"codeVoice"},{"text":". You can find out more about the argument parser library ","type":"text"},{"identifier":"https:\/\/apple.github.io\/swift-argument-parser\/documentation\/argumentparser","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"Open ","type":"text"},{"code":"Sources\/App\/App.swift","type":"codeVoice"}],"type":"paragraph"}],"code":"fluent-universe-07.swift","type":"step"},{"media":null,"runtimePreview":null,"caption":[],"content":[{"inlineContent":[{"text":"Add the new app arguments with default values.","type":"text"}],"type":"paragraph"}],"code":"fluent-universe-08.swift","type":"step"},{"media":null,"runtimePreview":null,"caption":[{"inlineContent":[{"text":"We can now add Fluent to our application’s lifecycle.","type":"text"}],"type":"paragraph"}],"content":[{"inlineContent":[{"text":"Open ","type":"text"},{"code":"Sources\/App\/Application+build.swift","type":"codeVoice"},{"text":" again.","type":"text"}],"type":"paragraph"}],"code":"fluent-universe-06.swift","type":"step"},{"media":null,"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Depending on the "},{"type":"codeVoice","code":"inMemoryDatabase"},{"type":"text","text":" boolean, this application can run completely in-memory. This is useful for testing, as it loses all data when the application is re-launched."}]}],"content":[{"type":"paragraph","inlineContent":[{"text":"First, create a Fluent object and add the SQLite driver to Fluent.","type":"text"}]}],"code":"fluent-universe-09.swift","type":"step"},{"media":null,"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"This allows it to integrate with Hummingbird’s ecosystem, including the Auth framework.","type":"text"}]}],"content":[{"type":"paragraph","inlineContent":[{"text":"Next, we’ll use Fluent as a persistence mechanism for the Persist framework. This step is ","type":"text"},{"inlineContent":[{"text":"optional","type":"text"}],"type":"strong"},{"text":" for this tutorial.","type":"text"}]}],"code":"fluent-universe-10.swift","type":"step"},{"media":null,"runtimePreview":null,"caption":[],"content":[{"inlineContent":[{"text":"Finally, both Fluent and the FluentPersistDriver are added to swift-service-lifecycle.","type":"text"}],"type":"paragraph"}],"code":"fluent-universe-11.swift","type":"step"}]},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Add your database models and routes to edit them.","type":"text"}]}],"kind":"contentAndMedia","media":"hummingbird.png","mediaPosition":"trailing"}],"anchor":"Add-Galaxy-API","title":"Add Galaxy API","stepsSection":[{"code":"fluent-universe-12.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a file named "},{"type":"codeVoice","code":"Galaxy.swift"},{"type":"text","text":", and add the following Fluent Model."}]}],"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"This Fluent model has the ‘id’ and a ‘name’ properties.","type":"text"}]}],"media":null},{"code":"fluent-universe-13.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Before being able to use a Model, a migration must be added."}]}],"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A migration creates or reverts a diff to the schema in the database."}]}],"media":null},{"code":"fluent-universe-14.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open "},{"code":"Sources\/App\/Application+build.swift","type":"codeVoice"},{"type":"text","text":" again. Fluent is now a completely blank slate, let’s set it up."}]}],"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"The newly added migrations are added to Fluent. Make sure that any new migrations are added to Fluent in the right order.","type":"text"}]}],"media":null},{"code":"fluent-universe-15.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The final step to set up Fluent is to run the migrations."}]}],"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"It’s common to explicitly run migrations, but for small scale set-ups can also run migrations on every app launch.","type":"text"}]}],"media":null},{"code":"fluent-universe-15.swift","type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"If we look further down the file we can find the ","type":"text"},{"code":"buildRouter()","type":"codeVoice"},{"text":" function.","type":"text"}]}],"runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"Here we create the ","type":"text"},{"type":"codeVoice","code":"Router"},{"text":". We add a logging middleware to it (this logs all requests to the router). The function uses a result builder to create a stack of middleware, but you can also use ","type":"text"},{"type":"codeVoice","code":"Router.add(middleware:)"},{"text":" to add individual middleware. Finally we add a single endpoint GET ","type":"text"},{"type":"codeVoice","code":"\/"},{"text":" which returns “Hello!”","type":"text"}]}],"media":null},{"code":"fluent-universe-16.swift","type":"step","content":[{"inlineContent":[{"type":"text","text":"We’ll add a single route "},{"type":"codeVoice","code":"GET \/galaxies"},{"type":"text","text":", which lists all registered galaxies."}],"type":"paragraph"}],"runtimePreview":null,"caption":[{"inlineContent":[{"type":"text","text":"Because the database is empty now, we’ll add a route "},{"code":"PUT \/galaxies","type":"codeVoice"},{"type":"text","text":" to add your own galaxies."}],"type":"paragraph"}],"media":null}]},{"contentSection":[{"mediaPosition":"trailing","kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Now that your Fluent backend is complete, it’s time to validate the results!","type":"text"}]}],"media":"hummingbird.png"}],"anchor":"Test-your-Backend","title":"Test your Backend","stepsSection":[{"caption":[{"type":"paragraph","inlineContent":[{"text":"First, create your own galaxy!","type":"text"}]}],"code":"fluent-universe-17.sh","runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"We can run the application and use curl to test it works."}]}],"media":null},{"caption":[],"code":"fluent-universe-18.sh","runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Then, query the list of galaxies."}]}],"media":null},{"caption":[],"code":"fluent-universe-19.sh","runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can see the galaxy added in the first call, is returned when we ask to list all the galaxies."}]}],"media":null}]}]}],"metadata":{"title":"Create a Hummingbird + Fluent application.","categoryPathComponent":"Fluent","role":"project","category":"Fluent Backend"},"variants":[{"paths":["\/tutorials\/hummingbird\/fluent-1-galaxy"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Fluent-1-Galaxy","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"fluent-universe-12.swift":{"highlights":[],"type":"file","syntax":"swift","fileType":"swift","identifier":"fluent-universe-12.swift","content":["import FluentKit","import Foundation","import Hummingbird","","final class Galaxy: Model, @unchecked Sendable, ResponseCodable {","    \/\/ Name of the table or collection.","    static let schema = \"galaxies\"","","    \/\/ Unique identifier for this Galaxy.","    @ID(key: .id)","    var id: UUID?","","    \/\/ The Galaxy's name.","    @Field(key: \"name\")","    var name: String","","    \/\/ Creates a new, empty Galaxy.","    init() { }","","    \/\/ Creates a new Galaxy with all properties set.","    init(id: UUID? = nil, name: String) {","        self.id = id","        self.name = name","    }","}"],"fileName":"Sources\/App\/Galaxy.swift"},"doc://com.opticalaberration.hummingbird/tutorials/Fluent/Build-a-Galaxy-Backend":{"kind":"article","abstract":[],"title":"Build a Galaxy Backend","role":"article","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Fluent\/Build-a-Galaxy-Backend","url":"\/tutorials\/fluent\/build-a-galaxy-backend","type":"topic"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Fluent-1-Galaxy#Add-Fluent":{"url":"\/tutorials\/hummingbird\/fluent-1-galaxy#Add-Fluent","title":"Add Fluent","abstract":[{"text":"Create a simple web application using the Hummingbird template.","type":"text"}],"type":"section","kind":"section","role":"pseudoSymbol","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Fluent-1-Galaxy#Add-Fluent"},"fluent-universe-15.swift":{"type":"file","syntax":"swift","highlights":[],"content":["import Hummingbird","import Logging","import FluentSQLiteDriver","import Foundation","import HummingbirdFluent","","\/\/\/ Application arguments protocol. We use a protocol so we can call","\/\/\/ `buildApplication` inside Tests as well as in the App executable.","\/\/\/ Any variables added here also have to be added to `App` in App.swift and","\/\/\/ `TestArguments` in AppTest.swift","public protocol AppArguments {","    var inMemoryDatabase: Bool { get }","    var migrate: Bool { get }","    var hostname: String { get }","    var port: Int { get }","    var logLevel: Logger.Level? { get }","}","","\/\/ Request context used by application","typealias AppRequestContext = BasicRequestContext","","\/\/\/  Build application","\/\/\/ - Parameter arguments: application arguments","public func buildApplication(_ arguments: some AppArguments) async throws -> some ApplicationProtocol {","    let environment = Environment()","    let logger = {","        var logger = Logger(label: \"TodosFluent\")","        logger.logLevel =","        arguments.logLevel ??","        environment.get(\"LOG_LEVEL\").flatMap { Logger.Level(rawValue: $0) } ??","            .info","        return logger","    }()","","    let fluent = Fluent(logger: logger)","    \/\/ add sqlite database","    if arguments.inMemoryDatabase {","        fluent.databases.use(.sqlite(.memory), as: .sqlite)","    } else {","        fluent.databases.use(.sqlite(.file(\"db.sqlite\")), as: .sqlite)","    }","    \/\/ add migrations","    await fluent.migrations.add(CreateGalaxy())","","    let fluentPersist = await FluentPersistDriver(fluent: fluent)","","    \/\/ migrate","    if arguments.migrate || arguments.inMemoryDatabase {","        try await fluent.migrate()","    }","","    let router = buildRouter()","    var app = Application(","        router: router,","        configuration: .init(","            address: .hostname(arguments.hostname, port: arguments.port),","            serverName: \"TodosFluent\"","        ),","        logger: logger","    )","    app.addServices(fluent, fluentPersist)","    return app","}","","\/\/\/ Build router","func buildRouter() -> Router<AppRequestContext> {","    let router = Router(context: AppRequestContext.self)","    \/\/ Add middleware","    router.addMiddleware {","        \/\/ logging middleware","        LogRequestsMiddleware(.info)","    }","    \/\/ Add default endpoint","    router.get(\"\/\") { _,_ in","        return \"Hello!\"","    }","    return router","}"],"identifier":"fluent-universe-15.swift","fileName":"Sources\/App\/Application+build.swift","fileType":"swift"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Fluent-1-Galaxy#Add-Galaxy-API":{"url":"\/tutorials\/hummingbird\/fluent-1-galaxy#Add-Galaxy-API","title":"Add Galaxy API","abstract":[{"type":"text","text":"Create a simple web application using the Hummingbird template."}],"type":"section","kind":"section","role":"pseudoSymbol","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Fluent-1-Galaxy#Add-Galaxy-API"},"https://apple.github.io/swift-argument-parser/documentation/argumentparser":{"identifier":"https:\/\/apple.github.io\/swift-argument-parser\/documentation\/argumentparser","titleInlineContent":[{"type":"text","text":"here"}],"title":"here","type":"link","url":"https:\/\/apple.github.io\/swift-argument-parser\/documentation\/argumentparser"},"hummingbird.png":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/com.opticalaberration.hummingbird\/hummingbird.png"}],"alt":"Hummingbird logo","identifier":"hummingbird.png"},"fluent-universe-01.sh":{"type":"file","syntax":"","highlights":[],"content":["> git clone https:\/\/github.com\/hummingbird-project\/template"],"identifier":"fluent-universe-01.sh","fileName":"Clone template","fileType":""},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Fluent-1-Galaxy":{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Fluent-1-Galaxy","title":"Create a Hummingbird + Fluent application.","role":"project","estimatedTime":"15min","type":"topic","kind":"project","url":"\/tutorials\/hummingbird\/fluent-1-galaxy","abstract":[{"type":"text","text":"Create a simple web application using the Hummingbird template."}]},"fluent-universe-19.sh":{"highlights":[{"line":2},{"line":3},{"line":4},{"line":5},{"line":6},{"line":7},{"line":8}],"type":"file","syntax":"","fileType":"","identifier":"fluent-universe-19.sh","content":["> curl -i localhost:8080\/galaxies","HTTP\/1.1 200 OK","Content-Type: application\/json; charset=utf-8","Content-Length: 66","Date: Thu, 21 Nov 2024 14:55:26 GMT","Server: TodosFluent","","[{\"id\":\"9DB14C0C-EC2E-4C51-84CB-A2BEB4CDF967\",\"name\":\"Andromeda\"}]"],"fileName":"Test Application"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Fluent-1-Galaxy#Test-your-Backend":{"kind":"section","abstract":[{"text":"Create a simple web application using the Hummingbird template.","type":"text"}],"title":"Test your Backend","role":"pseudoSymbol","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Fluent-1-Galaxy#Test-your-Backend","url":"\/tutorials\/hummingbird\/fluent-1-galaxy#Test-your-Backend","type":"section"},"fluent-universe-08.swift":{"highlights":[{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21}],"type":"file","syntax":"swift","fileType":"swift","content":["import ArgumentParser","import Hummingbird","import Logging","","@main","struct App: AsyncParsableCommand, AppArguments {","    @Option(name: .shortAndLong)","    var hostname: String = \"127.0.0.1\"","","    @Option(name: .shortAndLong)","    var port: Int = 8080","","    @Option(name: .shortAndLong)","    var logLevel: Logger.Level?","","    @Flag(name: .shortAndLong)","    var migrate: Bool = false","","    @Flag(name: .shortAndLong)","    var inMemoryDatabase: Bool = false","","    func run() async throws {","        let app = try await buildApplication(self)","        try await app.runService()","    }","}","","\/\/\/ Extend `Logger.Level` so it can be used as an argument","#if hasFeature(RetroactiveAttribute)","    extension Logger.Level: @retroactive ExpressibleByArgument {}","#else","    extension Logger.Level: ExpressibleByArgument {}","#endif"],"identifier":"fluent-universe-08.swift","fileName":"Sources\/App\/App.swift"},"fluent-universe-10.swift":{"type":"file","syntax":"swift","highlights":[{"line":43},{"line":44}],"content":["import Hummingbird","import Logging","import FluentSQLiteDriver","import Foundation","import HummingbirdFluent","","\/\/\/ Application arguments protocol. We use a protocol so we can call","\/\/\/ `buildApplication` inside Tests as well as in the App executable.","\/\/\/ Any variables added here also have to be added to `App` in App.swift and","\/\/\/ `TestArguments` in AppTest.swift","public protocol AppArguments {","    var inMemoryDatabase: Bool { get }","    var migrate: Bool { get }","    var hostname: String { get }","    var port: Int { get }","    var logLevel: Logger.Level? { get }","}","","\/\/ Request context used by application","typealias AppRequestContext = BasicRequestContext","","\/\/\/  Build application","\/\/\/ - Parameter arguments: application arguments","public func buildApplication(_ arguments: some AppArguments) async throws -> some ApplicationProtocol {","    let environment = Environment()","    let logger = {","        var logger = Logger(label: \"TodosFluent\")","        logger.logLevel =","        arguments.logLevel ??","        environment.get(\"LOG_LEVEL\").flatMap { Logger.Level(rawValue: $0) } ??","            .info","        return logger","    }()","","    let fluent = Fluent(logger: logger)","    \/\/ add sqlite database","    if arguments.inMemoryDatabase {","        fluent.databases.use(.sqlite(.memory), as: .sqlite)","    } else {","        fluent.databases.use(.sqlite(.file(\"db.sqlite\")), as: .sqlite)","    }","","    let fluentPersist = await FluentPersistDriver(fluent: fluent)","    ","    let router = buildRouter()","    let app = Application(","        router: router,","        configuration: .init(","            address: .hostname(arguments.hostname, port: arguments.port),","            serverName: \"TodosFluent\"","        ),","        logger: logger","    )","    return app","}","","\/\/\/ Build router","func buildRouter() -> Router<AppRequestContext> {","    let router = Router(context: AppRequestContext.self)","    \/\/ Add middleware","    router.addMiddleware {","        \/\/ logging middleware","        LogRequestsMiddleware(.info)","    }","    \/\/ Add default endpoint","    router.get(\"\/\") { _,_ in","        return \"Hello!\"","    }","    return router","}"],"identifier":"fluent-universe-10.swift","fileName":"Sources\/App\/Application+build.swift","fileType":"swift"},"fluent-universe-16.swift":{"highlights":[{"line":52},{"line":66},{"line":76},{"line":77},{"line":78},{"line":79},{"line":80},{"line":81},{"line":82},{"line":83},{"line":84}],"type":"file","syntax":"swift","fileType":"swift","identifier":"fluent-universe-16.swift","content":["import Hummingbird","import Logging","import FluentSQLiteDriver","import Foundation","import HummingbirdFluent","","\/\/\/ Application arguments protocol. We use a protocol so we can call","\/\/\/ `buildApplication` inside Tests as well as in the App executable.","\/\/\/ Any variables added here also have to be added to `App` in App.swift and","\/\/\/ `TestArguments` in AppTest.swift","public protocol AppArguments {","    var inMemoryDatabase: Bool { get }","    var migrate: Bool { get }","    var hostname: String { get }","    var port: Int { get }","    var logLevel: Logger.Level? { get }","}","","\/\/ Request context used by application","typealias AppRequestContext = BasicRequestContext","","\/\/\/  Build application","\/\/\/ - Parameter arguments: application arguments","public func buildApplication(_ arguments: some AppArguments) async throws -> some ApplicationProtocol {","    let environment = Environment()","    let logger = {","        var logger = Logger(label: \"TodosFluent\")","        logger.logLevel =","        arguments.logLevel ??","        environment.get(\"LOG_LEVEL\").flatMap { Logger.Level(rawValue: $0) } ??","            .info","        return logger","    }()","","    let fluent = Fluent(logger: logger)","    \/\/ add sqlite database","    if arguments.inMemoryDatabase {","        fluent.databases.use(.sqlite(.memory), as: .sqlite)","    } else {","        fluent.databases.use(.sqlite(.file(\"db.sqlite\")), as: .sqlite)","    }","    \/\/ add migrations","    await fluent.migrations.add(CreateGalaxy())","","    let fluentPersist = await FluentPersistDriver(fluent: fluent)","","    \/\/ migrate","    if arguments.migrate || arguments.inMemoryDatabase {","        try await fluent.migrate()","    }","","    let router = buildRouter(fluent: fluent)","    var app = Application(","        router: router,","        configuration: .init(","            address: .hostname(arguments.hostname, port: arguments.port),","            serverName: \"TodosFluent\"","        ),","        logger: logger","    )","    app.addServices(fluent, fluentPersist)","    return app","}","","\/\/\/ Build router","func buildRouter(fluent: Fluent) -> Router<AppRequestContext> {","    let router = Router(context: AppRequestContext.self)","    \/\/ Add middleware","    router.addMiddleware {","        \/\/ logging middleware","        LogRequestsMiddleware(.info)","    }","    \/\/ Add default endpoint","    router.get(\"\/\") { _,_ in","        return \"Hello!\"","    }","    \/\/ List all galaxies","    router.get(\"\/galaxies\") { _,_ -> [Galaxy] in","        try await Galaxy.query(on: self.fluent.db()).all()","    }","    router.put(\"\/galaxies\") { request, context -> Response in","        let galaxy = try await request.decode(as: Galaxy.self, context: context)","        try await galaxy.save(on: fluent.db())","        return Response(status: .created)","    }","    return router","}"],"fileName":"Sources\/App\/Application+build.swift"},"fluent-universe-17.sh":{"fileType":"","syntax":"","highlights":[],"content":["> curl -i -X PUT -H \"Content-Type: application\/json\" -d '{\"name\":\"Andromeda\"}' localhost:8080\/galaxies","HTTP\/1.1 201 Created","Content-Length: 0","Date: Sat, 23 Nov 2024 09:22:26 GMT","Server: TodosFluent"],"identifier":"fluent-universe-17.sh","fileName":"Test Application","type":"file"},"fluent-universe-02.sh":{"highlights":[],"type":"file","syntax":"","fileType":"","identifier":"fluent-universe-02.sh","content":["> .\/template\/configure.sh TodosFluent","Enter your package name: [TodosFluent] > ","Enter your executable name: [App] > ","Include Visual Studio Code snippets: [Y\/n] > "],"fileName":"Create Swift Package"},"fluent-universe-13.swift":{"fileType":"swift","syntax":"swift","highlights":[{"line":26},{"line":27},{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34},{"line":35},{"line":36},{"line":37},{"line":38}],"content":["import FluentKit","import Foundation","import Hummingbird","","final class Galaxy: Model, @unchecked Sendable, ResponseCodable {","    \/\/ Name of the table or collection.","    static let schema = \"galaxies\"","","    \/\/ Unique identifier for this Galaxy.","    @ID(key: .id)","    var id: UUID?","","    \/\/ The Galaxy's name.","    @Field(key: \"name\")","    var name: String","","    \/\/ Creates a new, empty Galaxy.","    init() { }","","    \/\/ Creates a new Galaxy with all properties set.","    init(id: UUID? = nil, name: String) {","        self.id = id","        self.name = name","    }","}","","struct CreateGalaxy: AsyncMigration {","    func prepare(on database: Database) async throws {","        return try await database.schema(Galaxy.schema)","            .id()","            .field(\"name\", .string, .required)","            .create()","    }","","    func revert(on database: Database) async throws {","        return try await database.schema(Galaxy.schema).delete()","    }","}"],"identifier":"fluent-universe-13.swift","fileName":"Sources\/App\/Galaxy.swift","type":"file"},"fluent-universe-18.sh":{"highlights":[{"line":1}],"type":"file","syntax":"","fileType":"","content":["> curl -i localhost:8080\/galaxies"],"identifier":"fluent-universe-18.sh","fileName":"Test Application"},"fluent-universe-14.swift":{"type":"file","syntax":"swift","highlights":[{"