ing on the "},{"type":"codeVoice","code":"inMemoryDatabase"},{"type":"text","text":" boolean, this application can run completely in-memory. This is useful for testing, as it loses all data when the application is re-launched."}]}]},{"media":null,"code":"fluent-universe-10.swift","runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Next, we’ll use Fluent as a persistence mechanism for the Persist framework. This step is ","type":"text"},{"inlineContent":[{"text":"optional","type":"text"}],"type":"strong"},{"text":" for this tutorial.","type":"text"}]}],"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This allows it to integrate with Hummingbird’s ecosystem, including the Auth framework."}]}]},{"media":null,"code":"fluent-universe-11.swift","runtimePreview":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Finally, both Fluent and the FluentPersistDriver are added to swift-service-lifecycle."}],"type":"paragraph"}],"caption":[]}],"title":"Add Fluent","anchor":"Add-Fluent"},{"contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add your database models and routes to edit them."}]}],"media":"hummingbird.png","mediaPosition":"trailing"}],"stepsSection":[{"caption":[{"inlineContent":[{"type":"text","text":"This Fluent model has the ‘id’ and a ‘name’ properties."}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"Create a file named "},{"type":"codeVoice","code":"Galaxy.swift"},{"type":"text","text":", and add the following Fluent Model."}],"type":"paragraph"}],"code":"fluent-universe-12.swift","media":null,"runtimePreview":null,"type":"step"},{"caption":[{"type":"paragraph","inlineContent":[{"text":"A migration creates or reverts a diff to the schema in the database.","type":"text"}]}],"content":[{"type":"paragraph","inlineContent":[{"text":"Before being able to use a Model, a migration must be added.","type":"text"}]}],"code":"fluent-universe-13.swift","media":null,"runtimePreview":null,"type":"step"},{"caption":[{"inlineContent":[{"type":"text","text":"The newly added migrations are added to Fluent. Make sure that any new migrations are added to Fluent in the right order."}],"type":"paragraph"}],"content":[{"inlineContent":[{"type":"text","text":"Open "},{"type":"codeVoice","code":"Sources\/App\/Application+build.swift"},{"type":"text","text":" again. Fluent is now a completely blank slate, let’s set it up."}],"type":"paragraph"}],"code":"fluent-universe-14.swift","media":null,"runtimePreview":null,"type":"step"},{"caption":[{"type":"paragraph","inlineContent":[{"text":"It’s common to explicitly run migrations, but for small scale set-ups can also run migrations on every app launch.","type":"text"}]}],"content":[{"type":"paragraph","inlineContent":[{"text":"The final step to set up Fluent is to run the migrations.","type":"text"}]}],"code":"fluent-universe-15.swift","media":null,"runtimePreview":null,"type":"step"},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Here we create the "},{"type":"codeVoice","code":"Router"},{"type":"text","text":". We add a logging middleware to it (this logs all requests to the router). The function uses a result builder to create a stack of middleware, but you can also use "},{"type":"codeVoice","code":"Router.add(middleware:)"},{"type":"text","text":" to add individual middleware. Finally we add a single endpoint GET "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" which returns “Hello!”"}]}],"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If we look further down the file we can find the "},{"type":"codeVoice","code":"buildRouter()"},{"type":"text","text":" function."}]}],"code":"fluent-universe-15.swift","media":null,"runtimePreview":null,"type":"step"},{"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Because the database is empty now, we’ll add a route "},{"type":"codeVoice","code":"PUT \/galaxies"},{"type":"text","text":" to add your own galaxies."}]}],"content":[{"type":"paragraph","inlineContent":[{"text":"We’ll add a single route ","type":"text"},{"code":"GET \/galaxies","type":"codeVoice"},{"text":", which lists all registered galaxies.","type":"text"}]}],"code":"fluent-universe-16.swift","media":null,"runtimePreview":null,"type":"step"}],"title":"Add Galaxy API","anchor":"Add-Galaxy-API"},{"contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now that your Fluent backend is complete, it’s time to validate the results!"}]}],"kind":"contentAndMedia","media":"hummingbird.png","mediaPosition":"trailing"}],"stepsSection":[{"content":[{"inlineContent":[{"text":"We can run the application and use curl to test it works.","type":"text"}],"type":"paragraph"}],"media":null,"code":"fluent-universe-17.sh","runtimePreview":null,"type":"step","caption":[{"inlineContent":[{"text":"First, create your own galaxy!","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Then, query the list of galaxies.","type":"text"}],"type":"paragraph"}],"media":null,"code":"fluent-universe-18.sh","runtimePreview":null,"type":"step","caption":[]},{"content":[{"inlineContent":[{"text":"You can see the galaxy added in the first call, is returned when we ask to list all the galaxies.","type":"text"}],"type":"paragraph"}],"media":null,"code":"fluent-universe-19.sh","runtimePreview":null,"type":"step","caption":[]}],"title":"Test your Backend","anchor":"Test-your-Backend"}],"kind":"tasks"}],"identifier":{"url":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Fluent-1-Galaxy","interfaceLanguage":"swift"},"variants":[{"paths":["\/tutorials\/hummingbird\/fluent-1-galaxy"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"fluent-universe-11.swift":{"type":"file","highlights":[{"line":46},{"line":54}],"fileType":"swift","identifier":"fluent-universe-11.swift","syntax":"swift","content":["import Hummingbird","import Logging","import FluentSQLiteDriver","import Foundation","import HummingbirdFluent","","\/\/\/ Application arguments protocol. We use a protocol so we can call","\/\/\/ `buildApplication` inside Tests as well as in the App executable.","\/\/\/ Any variables added here also have to be added to `App` in App.swift and","\/\/\/ `TestArguments` in AppTest.swift","public protocol AppArguments {","    var inMemoryDatabase: Bool { get }","    var migrate: Bool { get }","    var hostname: String { get }","    var port: Int { get }","    var logLevel: Logger.Level? { get }","}","","\/\/ Request context used by application","typealias AppRequestContext = BasicRequestContext","","\/\/\/  Build application","\/\/\/ - Parameter arguments: application arguments","public func buildApplication(_ arguments: some AppArguments) async throws -> some ApplicationProtocol {","    let environment = Environment()","    let logger = {","        var logger = Logger(label: \"TodosFluent\")","        logger.logLevel =","        arguments.logLevel ??","        environment.get(\"LOG_LEVEL\").flatMap { Logger.Level(rawValue: $0) } ??","            .info","        return logger","    }()","","    let fluent = Fluent(logger: logger)","    \/\/ add sqlite database","    if arguments.inMemoryDatabase {","        fluent.databases.use(.sqlite(.memory), as: .sqlite)","    } else {","        fluent.databases.use(.sqlite(.file(\"db.sqlite\")), as: .sqlite)","    }","","    let fluentPersist = await FluentPersistDriver(fluent: fluent)","    ","    let router = buildRouter()","    var app = Application(","        router: router,","        configuration: .init(","            address: .hostname(arguments.hostname, port: arguments.port),","            serverName: \"TodosFluent\"","        ),","        logger: logger","    )","    app.addServices(fluent, fluentPersist)","    return app","}","","\/\/\/ Build router","func buildRouter() -> Router<AppRequestContext> {","    let router = Router(context: AppRequestContext.self)","    \/\/ Add middleware","    router.addMiddleware {","        \/\/ logging middleware","        LogRequestsMiddleware(.info)","    }","    \/\/ Add default endpoint","    router.get(\"\/\") { _,_ in","        return \"Hello!\"","    }","    return router","}"],"fileName":"Sources\/App\/Application+build.swift"},"fluent-universe-16.swift":{"type":"file","content":["import Hummingbird","import Logging","import FluentSQLiteDriver","import Foundation","import HummingbirdFluent","","\/\/\/ Application arguments protocol. We use a protocol so we can call","\/\/\/ `buildApplication` inside Tests as well as in the App executable.","\/\/\/ Any variables added here also have to be added to `App` in App.swift and","\/\/\/ `TestArguments` in AppTest.swift","public protocol AppArguments {","    var inMemoryDatabase: Bool { get }","    var migrate: Bool { get }","    var hostname: String { get }","    var port: Int { get }","    var logLevel: Logger.Level? { get }","}","","\/\/ Request context used by application","typealias AppRequestContext = BasicRequestContext","","\/\/\/  Build application","\/\/\/ - Parameter arguments: application arguments","public func buildApplication(_ arguments: some AppArguments) async throws -> some ApplicationProtocol {","    let environment = Environment()","    let logger = {","        var logger = Logger(label: \"TodosFluent\")","        logger.logLevel =","        arguments.logLevel ??","        environment.get(\"LOG_LEVEL\").flatMap { Logger.Level(rawValue: $0) } ??","            .info","        return logger","    }()","","    let fluent = Fluent(logger: logger)","    \/\/ add sqlite database","    if arguments.inMemoryDatabase {","        fluent.databases.use(.sqlite(.memory), as: .sqlite)","    } else {","        fluent.databases.use(.sqlite(.file(\"db.sqlite\")), as: .sqlite)","    }","    \/\/ add migrations","    await fluent.migrations.add(CreateGalaxy())","","    let fluentPersist = await FluentPersistDriver(fluent: fluent)","","    \/\/ migrate","    if arguments.migrate || arguments.inMemoryDatabase {","        try await fluent.migrate()","    }","","    let router = buildRouter(fluent: fluent)","    var app = Application(","        router: router,","        configuration: .init(","            address: .hostname(arguments.hostname, port: arguments.port),","            serverName: \"TodosFluent\"","        ),","        logger: logger","    )","    app.addServices(fluent, fluentPersist)","    return app","}","","\/\/\/ Build router","func buildRouter(fluent: Fluent) -> Router<AppRequestContext> {","    let router = Router(context: AppRequestContext.self)","    \/\/ Add middleware","    router.addMiddleware {","        \/\/ logging middleware","        LogRequestsMiddleware(.info)","    }","    \/\/ Add default endpoint","    router.get(\"\/\") { _,_ in","        return \"Hello!\"","    }","    \/\/ List all galaxies","    router.get(\"\/galaxies\") { _,_ -> [Galaxy] in","        try await Galaxy.query(on: self.fluent.db()).all()","    }","    router.put(\"\/galaxies\") { request, context -> Response in","        let galaxy = try await request.decode(as: Galaxy.self, context: context)","        try await galaxy.save(on: fluent.db())","        return Response(status: .created)","    }","    return router","}"],"fileType":"swift","identifier":"fluent-universe-16.swift","syntax":"swift","highlights":[{"line":52},{"line":66},{"line":76},{"line":77},{"line":78},{"line":79},{"line":80},{"line":81},{"line":82},{"line":83},{"line":84}],"fileName":"Sources\/App\/Application+build.swift"},"fluent-universe-18.sh":{"type":"file","highlights":[{"line":1}],"fileType":"","content":["> curl -i localhost:8080\/galaxies"],"syntax":"","identifier":"fluent-universe-18.sh","fileName":"Test Application"},"fluent-universe-08.swift":{"type":"file","content":["import ArgumentParser","import Hummingbird","import Logging","","@main","struct App: AsyncParsableCommand, AppArguments {","    @Option(name: .shortAndLong)","    var hostname: String = \"127.0.0.1\"","","    @Option(name: .shortAndLong)","    var port: Int = 8080","","    @Option(name: .shortAndLong)","    var logLevel: Logger.Level?","","    @Flag(name: .shortAndLong)","    var migrate: Bool = false","","    @Flag(name: .shortAndLong)","    var inMemoryDatabase: Bool = false","","    func run() async throws {","        let app = try await buildApplication(self)","        try await app.runService()","    }","}","","\/\/\/ Extend `Logger.Level` so it can be used as an argument","#if hasFeature(RetroactiveAttribute)","    extension Logger.Level: @retroactive ExpressibleByArgument {}","#else","    extension Logger.Level: ExpressibleByArgument {}","#endif"],"identifier":"fluent-universe-08.swift","fileType":"swift","syntax":"swift","highlights":[{"line":16},{"line":17},{"line":18},{"line":19},{"line":20},{"line":21}],"fileName":"Sources\/App\/App.swift"},"fluent-universe-15.swift":{"type":"file","highlights":[],"fileType":"swift","identifier":"fluent-universe-15.swift","syntax":"swift","content":["import Hummingbird","import Logging","import FluentSQLiteDriver","import Foundation","import HummingbirdFluent","","\/\/\/ Application arguments protocol. We use a protocol so we can call","\/\/\/ `buildApplication` inside Tests as well as in the App executable.","\/\/\/ Any variables added here also have to be added to `App` in App.swift and","\/\/\/ `TestArguments` in AppTest.swift","public protocol AppArguments {","    var inMemoryDatabase: Bool { get }","    var migrate: Bool { get }","    var hostname: String { get }","    var port: Int { get }","    var logLevel: Logger.Level? { get }","}","","\/\/ Request context used by application","typealias AppRequestContext = BasicRequestContext","","\/\/\/  Build application","\/\/\/ - Parameter arguments: application arguments","public func buildApplication(_ arguments: some AppArguments) async throws -> some ApplicationProtocol {","    let environment = Environment()","    let logger = {","        var logger = Logger(label: \"TodosFluent\")","        logger.logLevel =","        arguments.logLevel ??","        environment.get(\"LOG_LEVEL\").flatMap { Logger.Level(rawValue: $0) } ??","            .info","        return logger","    }()","","    let fluent = Fluent(logger: logger)","    \/\/ add sqlite database","    if arguments.inMemoryDatabase {","        fluent.databases.use(.sqlite(.memory), as: .sqlite)","    } else {","        fluent.databases.use(.sqlite(.file(\"db.sqlite\")), as: .sqlite)","    }","    \/\/ add migrations","    await fluent.migrations.add(CreateGalaxy())","","    let fluentPersist = await FluentPersistDriver(fluent: fluent)","","    \/\/ migrate","    if arguments.migrate || arguments.inMemoryDatabase {","        try await fluent.migrate()","    }","","    let router = buildRouter()","    var app = Application(","        router: router,","        configuration: .init(","            address: .hostname(arguments.hostname, port: arguments.port),","            serverName: \"TodosFluent\"","        ),","        logger: logger","    )","    app.addServices(fluent, fluentPersist)","    return app","}","","\/\/\/ Build router","func buildRouter() -> Router<AppRequestContext> {","    let router = Router(context: AppRequestContext.self)","    \/\/ Add middleware","    router.addMiddleware {","        \/\/ logging middleware","        LogRequestsMiddleware(.info)","    }","    \/\/ Add default endpoint","    router.get(\"\/\") { _,_ in","        return \"Hello!\"","    }","    return router","}"],"fileName":"Sources\/App\/Application+build.swift"},"fluent-universe-07.swift":{"type":"file","content":["import ArgumentParser","import Hummingbird","import Logging","","@main","struct App: AsyncParsableCommand, AppArguments {","    @Option(name: .shortAndLong)","    var hostname: String = \"127.0.0.1\"","","    @Option(name: .shortAndLong)","    var port: Int = 8080","","    @Option(name: .shortAndLong)","    var logLevel: Logger.Level?","","    func run() async throws {","        let app = try await buildApplication(self)","        try await app.runService()","    }","}","","\/\/\/ Extend `Logger.Level` so it can be used as an argument","#if hasFeature(RetroactiveAttribute)","    extension Logger.Level: @retroactive ExpressibleByArgument {}","#else","    extension Logger.Level: ExpressibleByArgument {}","#endif"],"identifier":"fluent-universe-07.swift","fileType":"swift","syntax":"swift","highlights":[],"fileName":"Sources\/App\/App.swift"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Fluent-1-Galaxy#Add-Galaxy-API":{"type":"section","abstract":[{"text":"Create a simple web application using the Hummingbird template.","type":"text"}],"kind":"section","url":"\/tutorials\/hummingbird\/fluent-1-galaxy#Add-Galaxy-API","title":"Add Galaxy API","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Fluent-1-Galaxy#Add-Galaxy-API","role":"pseudoSymbol"},"doc://com.opticalaberration.hummingbird/tutorials/Fluent/Build-a-Galaxy-Backend":{"title":"Build a Galaxy Backend","type":"topic","abstract":[],"role":"article","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Fluent\/Build-a-Galaxy-Backend","url":"\/tutorials\/fluent\/build-a-galaxy-backend","kind":"article"},"hummingbird.png":{"alt":"Hummingbird logo","variants":[{"traits":["1x","light"],"url":"\/images\/com.opticalaberration.hummingbird\/hummingbird.png"}],"type":"image","identifier":"hummingbird.png"},"fluent-universe-12.swift":{"type":"file","highlights":[],"fileType":"swift","identifier":"fluent-universe-12.swift","syntax":"swift","content":["import FluentKit","import Foundation","import Hummingbird","","final class Galaxy: Model, @unchecked Sendable, ResponseCodable {","    \/\/ Name of the table or collection.","    static let schema = \"galaxies\"","","    \/\/ Unique identifier for this Galaxy.","    @ID(key: .id)","    var 