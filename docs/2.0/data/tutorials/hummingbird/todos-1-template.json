{"sections":[{"title":"Create a Hummingbird application.","content":[{"inlineContent":[{"text":"Create a simple web application using the Hummingbird template.","type":"text"}],"type":"paragraph"}],"kind":"hero","estimatedTimeInMinutes":5,"image":"hummingbird.png","chapter":"Application Setup","backgroundImage":"hummingbird.png"},{"tasks":[{"stepsSection":[{"caption":[],"runtimePreview":null,"code":"todos-template-01.sh","media":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Clone the Hummingbird template GitHub project","type":"text"}]}]},{"caption":[],"runtimePreview":null,"code":"todos-template-02.sh","media":null,"type":"step","content":[{"inlineContent":[{"type":"text","text":"Create your project, using the template configure script. Press return on each question to use the default value."}],"type":"paragraph"}]},{"caption":[{"inlineContent":[{"type":"text","text":"You can see if has dependencies for Hummingbird and the Apple’s Configuration library."}],"type":"paragraph"}],"runtimePreview":null,"code":"todos-template-03.swift","media":null,"type":"step","content":[{"inlineContent":[{"text":"Now lets review what the template has setup. Open ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"caption":[{"inlineContent":[{"type":"text","text":"This contains an "},{"code":"App","type":"codeVoice"},{"type":"text","text":" tagged with "},{"code":"@main","type":"codeVoice"},{"type":"text","text":". The "},{"code":"main","type":"codeVoice"},{"type":"text","text":" function in "},{"code":"App","type":"codeVoice"},{"type":"text","text":" sets up a "},{"code":"ConfigReader","type":"codeVoice"},{"type":"text","text":" to read configuration values from the command line arguments, environment variables, a "},{"code":".env","type":"codeVoice"},{"type":"text","text":" file and in-memory values in that order. Then it calls "},{"code":"buildApplication(reader:)","type":"codeVoice"},{"type":"text","text":" with the "},{"code":"ConfigReader","type":"codeVoice"},{"type":"text","text":" to create an "},{"code":"Application","type":"codeVoice"},{"type":"text","text":" and runs it using "},{"code":"runService()","type":"codeVoice"},{"type":"text","text":". You can find out more about the Configuration library "},{"isActive":true,"type":"reference","identifier":"https:\/\/swiftpackageindex.com\/apple\/swift-configuration\/1.0.0\/documentation\/configuration"},{"type":"text","text":"."}],"type":"paragraph"}],"runtimePreview":null,"code":"todos-template-04.swift","media":null,"type":"step","content":[{"inlineContent":[{"text":"Open ","type":"text"},{"type":"codeVoice","code":"Sources\/App\/App.swift"}],"type":"paragraph"}]},{"caption":[{"type":"paragraph","inlineContent":[{"text":"Here we create a ","type":"text"},{"type":"codeVoice","code":"Logger"},{"text":" with log level extracted from the configuration reader mentioned above. We then call a function ","type":"text"},{"type":"codeVoice","code":"buildRouter()"},{"text":" and use the result of that to create our ","type":"text"},{"type":"codeVoice","code":"Application"},{"text":". The application uses configuration values ","type":"text"},{"type":"codeVoice","code":"HTTP_HOST"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"HTTP_PORT"},{"text":" to define its bind address.","type":"text"}]}],"runtimePreview":null,"code":"todos-template-05.swift","media":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open "},{"code":"Sources\/App\/App+build.swift","type":"codeVoice"},{"type":"text","text":" to find the `buildApplication(_:) function."}]}]},{"caption":[{"inlineContent":[{"type":"text","text":"Here we create the "},{"type":"codeVoice","code":"Router"},{"type":"text","text":". We add a logging middleware to it (this logs all requests to the router). The function uses a result builder to create a stack of middleware, but you can also use "},{"type":"codeVoice","code":"Router.add(middleware:)"},{"type":"text","text":" to add individual middleware. Finally we add a single endpoint GET "},{"type":"codeVoice","code":"\/"},{"type":"text","text":" which returns a String response: “Hello!”."}],"type":"paragraph"}],"runtimePreview":null,"code":"todos-template-06.swift","media":null,"type":"step","content":[{"inlineContent":[{"text":"If we look further down the file we can find the ","type":"text"},{"type":"codeVoice","code":"buildRouter()"},{"text":" function.","type":"text"}],"type":"paragraph"}]},{"caption":[],"runtimePreview":null,"code":"todos-template-07.sh","media":null,"type":"step","content":[{"inlineContent":[{"text":"We can run this application and use curl to test it works.","type":"text"}],"type":"paragraph"}]},{"caption":[],"runtimePreview":null,"code":"todos-template-08.sh","media":null,"type":"step","content":[{"inlineContent":[{"text":"Now we have a running server, lets add some functionality to it.","type":"text"}],"type":"paragraph"}]}],"title":"Create your project","contentSection":[{"kind":"contentAndMedia","media":"hummingbird.png","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Clone the Hummingbird template, configure a project and review the contents of the generated project."}]}],"mediaPosition":"trailing"}],"anchor":"Create-your-project"}],"kind":"tasks"},{"featuredEyebrow":"Tutorial","action":{"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-2-API","isActive":true,"overridingTitle":"Get started","overridingTitleInlineContent":[{"type":"text","text":"Get started"}]},"abstract":[{"type":"text","text":"Add some functionality to your application."}],"kind":"callToAction","title":"Add your application API"}],"kind":"project","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/tutorials\/hummingbird\/todos-1-template"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"category":"Todo backend","role":"