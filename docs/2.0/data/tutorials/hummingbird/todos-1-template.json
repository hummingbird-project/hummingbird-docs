{"sections":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Create a simple web application using the Hummingbird template.","type":"text"}]}],"kind":"hero","image":"hummingbird.png","title":"Create a Hummingbird application.","backgroundImage":"hummingbird.png","chapter":"Application Setup","estimatedTimeInMinutes":5},{"kind":"tasks","tasks":[{"title":"Create your project","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Clone the Hummingbird template, configure a project and review the contents of the generated project."}]}],"kind":"contentAndMedia","media":"hummingbird.png","mediaPosition":"trailing"}],"stepsSection":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Clone the Hummingbird template GitHub project","type":"text"}]}],"runtimePreview":null,"media":null,"type":"step","code":"todos-template-01.sh","caption":[]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create your project, using the template configure script. Press return on each question to use the default value."}]}],"runtimePreview":null,"media":null,"type":"step","code":"todos-template-02.sh","caption":[]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Now lets review what the template has setup. Open ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":".","type":"text"}]}],"runtimePreview":null,"media":null,"type":"step","code":"todos-template-03.swift","caption":[{"type":"paragraph","inlineContent":[{"text":"You can see if has dependencies for Hummingbird and the Apple’s Configuration library.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open "},{"type":"codeVoice","code":"Sources\/App\/App.swift"}]}],"runtimePreview":null,"media":null,"type":"step","code":"todos-template-04.swift","caption":[{"type":"paragraph","inlineContent":[{"text":"This contains an ","type":"text"},{"code":"App","type":"codeVoice"},{"text":" tagged with ","type":"text"},{"code":"@main","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"main","type":"codeVoice"},{"text":" function in ","type":"text"},{"code":"App","type":"codeVoice"},{"text":" sets up a ","type":"text"},{"code":"ConfigReader","type":"codeVoice"},{"text":" to read configuration values from the command line arguments, environment variables, a ","type":"text"},{"code":".env","type":"codeVoice"},{"text":" file and in-memory values in that order. Then it calls ","type":"text"},{"code":"buildApplication(reader:)","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"ConfigReader","type":"codeVoice"},{"text":" to create an ","type":"text"},{"code":"Application","type":"codeVoice"},{"text":" and runs it using ","type":"text"},{"code":"runService()","type":"codeVoice"},{"text":". You can find out more about the Configuration library ","type":"text"},{"identifier":"https:\/\/swiftpackageindex.com\/apple\/swift-configuration\/1.0.0\/documentation\/configuration","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Open ","type":"text"},{"code":"Sources\/App\/App+build.swift","type":"codeVoice"},{"text":" to find the `buildApplication(_:) function.","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"media":null,"type":"step","code":"todos-template-05.swift","caption":[{"inlineContent":[{"type":"text","text":"Here we create a "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":" with log level extracted from the configuration reader mentioned above. We then call a function "},{"type":"codeVoice","code":"buildRouter()"},{"type":"text","text":" and use the result of that to create our "},{"type":"codeVoice","code":"Application"},{"type":"text","text":". The application uses configuration values "},{"type":"codeVoice","code":"HTTP_HOST"},{"type":"text","text":" and "},{"type":"codeVoice","code":"HTTP_PORT"},{"type":"text","text":" to define its bind address."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If we look further down the file we can find the "},{"code":"buildRouter()","type":"codeVoice"},{"type":"text","text":" function."}],"type":"paragraph"}],"runtimePreview":null,"media":null,"type":"step","code":"todos-template-06.swift","caption":[{"inlineContent":[{"text":"Here we create the ","type":"text"},{"code":"Router","type":"codeVoice"},{"text":". We add a logging middleware to it (this logs all requests to the router). The function uses a result builder to create a stack of middleware, but you can also use ","type":"text"},{"code":"Router.add(middleware:)","type":"codeVoice"},{"text":" to add individual middleware. Finally we add a single endpoint GET ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" which returns a String response: “Hello!”.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"We can run this application and use curl to test it works.","type":"text"}]}],"runtimePreview":null,"media":null,"type":"step","code":"todos-template-07.sh","caption":[]},{"content":[{"inlineContent":[{"type":"text","text":"Now we have a running server, lets add some functionality to it."}],"type":"paragraph"}],"runtimePreview":null,"media":null,"type":"step","code":"todos-template-08.sh","caption":[]}],"anchor":"Create-your-project"}]},{"kind":"callToAction","featuredEyebrow":"Tutorial","abstract":[{"type":"text","text":"Add some functionality to your application."}],"title":"Add your application API","action":{"isActive":true,"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-2-API","overridingTitle":"Get started","overridingTitleInlineContent":[{"text":"Get started","type":"text"}]}}],"kind":"project","hierarchy":{"modules":[{"projects":[{"sections":[{"kind":"task","reference":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-1-Template#Create-your-project"}],"reference":"doc:\/\