{"sections":[{"title":"Create a Hummingbird application.","estimatedTimeInMinutes":5,"chapter":"Application Setup","backgroundImage":"hummingbird.png","content":[{"inlineContent":[{"text":"Create a simple web application using the Hummingbird template.","type":"text"}],"type":"paragraph"}],"kind":"hero","image":"hummingbird.png"},{"tasks":[{"anchor":"Create-your-project","contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"Clone the Hummingbird template, configure a project and review the contents of the generated project.","type":"text"}]}],"mediaPosition":"trailing","media":"hummingbird.png"}],"title":"Create your project","stepsSection":[{"content":[{"inlineContent":[{"text":"Clone the Hummingbird template GitHub project","type":"text"}],"type":"paragraph"}],"runtimePreview":null,"code":"todos-template-01.sh","caption":[],"media":null,"type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create your project, using the template configure script. Press return on each question to use the default value."}]}],"runtimePreview":null,"code":"todos-template-02.sh","caption":[],"media":null,"type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Now lets review what the template has setup. Open "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":"."}]}],"runtimePreview":null,"code":"todos-template-03.swift","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You can see if has dependencies for Hummingbird and the Apple’s Configuration library."}]}],"media":null,"type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open "},{"type":"codeVoice","code":"Sources\/App\/App.swift"}]}],"runtimePreview":null,"code":"todos-template-04.swift","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This contains an "},{"type":"codeVoice","code":"App"},{"type":"text","text":" tagged with "},{"type":"codeVoice","code":"@main"},{"type":"text","text":". The "},{"type":"codeVoice","code":"main"},{"type":"text","text":" function in "},{"type":"codeVoice","code":"App"},{"type":"text","text":" sets up a "},{"type":"codeVoice","code":"ConfigReader"},{"type":"text","text":" to read configuration values from the command line arguments, environment variables, a "},{"type":"codeVoice","code":".env"},{"type":"text","text":" file and in-memory values in that order. Then it calls "},{"type":"codeVoice","code":"buildApplication(reader:)"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"ConfigReader"},{"type":"text","text":" to create an "},{"type":"codeVoice","code":"Application"},{"type":"text","text":" and runs it using "},{"type":"codeVoice","code":"runService()"},{"type":"text","text":". You can find out more about the Configuration library "},{"identifier":"https:\/\/swiftpackageindex.com\/apple\/swift-configuration\/1.0.0\/documentation\/configuration","type":"reference","isActive":true},{"type":"text","text":"."}]}],"media":null,"type":"step"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Open ","type":"text"},{"type":"codeVoice","code":"Sources\/App\/App+build.swift"},{"text":" to find the `buildApplication(_:) function.","type":"text"}]}],"runtimePreview":null,"code":"todos-template-05.swift","caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Here we create a "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":" with log level extracted from the configuration reader mentioned above. We then call a function "},{"type":"codeVoice","code":"buildRouter()"},{"type":"text","text":" and use the result of that to create our "},{"type":"codeVoice","code":"Application"},{"type":"text","text":". The application uses configuration values "},{"type":"codeVoice","code":"HTTP_HOST"},{"type":"text","text":" and "},{"type":"codeVoice","code":"HTTP_PORT"},{"type":"text","text":" to define its bind address."}]}],"media":null,"type":"step"},{"content":[{"inlineContent":[{"type":"text","text":"If we look further down the file we can find the "},{"type":"codeVoice","code":"buildRouter()"},{"type":"text","text":" function."}],"type":"paragraph"}],"runtimePreview":null,"code":"todos-template-06.swift","caption":[{"inlineContent":[{"text":"Here we create the ","type":"text"},{"code":"Router","type":"codeVoice"},{"text":". We add a logging middleware to it (this logs all requests to the router). The function uses a result builder to create a stack of middleware, but you can also use ","type":"text"},{"code":"Router.add(middleware:)","type":"codeVoice"},{"text":" to add individual middleware. Finally we add a single endpoint GET ","type":"text"},{"code":"\/","type":"codeVoice"},{"text":" which returns a String response: “Hello!”.","type":"text"}],"type":"paragraph"}],"media":null,"type":"step"},{"content":[{"inlineContent":[{"type":"text","text":"We can run this application and use curl to test it works."}],"type":"paragraph"}],"runtimePreview":null,"code":"todos-template-07.sh","caption":[],"media":null,"type":"step"},{"content":[{"inlineContent":[{"type":"text","text":"Now we have a running server, lets add some functionality to it."}],"type":"paragraph"}],"runtimePreview":null,"code":"todos-template-08.sh","caption":[],"media":null,"type":"step"}]}],"kind":"tasks"},{"action":{"isActive":true,"overridingTitleInlineContent":[{"type":"text","text":"Get started"}],"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-2-API","overridingTitle":"Get started"},"title":"Add your application API","featuredEyebrow":"Tutorial","abstract":[{"type":"text","text":"Add some functionality to your application."}],"kind":"callToAction"}],"hierarchy":{"modules":[{"projects":[{"reference":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-1-Template","sections":[{"kind":"task","reference":"doc:\/\/com.opticalaberration.hummingbird\/tut