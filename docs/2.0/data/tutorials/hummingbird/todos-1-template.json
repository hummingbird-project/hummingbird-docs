hummingbird\/tutorials\/Hummingbird\/Todos-4-Postgres#Setup-a-Postgres-repository","kind":"task"}],"reference":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-4-Postgres"}]}]},"variants":[{"paths":["\/tutorials\/hummingbird\/todos-1-template"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-1-Template"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[{"kind":"hero","chapter":"Application Setup","image":"hummingbird.png","estimatedTimeInMinutes":5,"backgroundImage":"hummingbird.png","content":[{"inlineContent":[{"text":"Create a simple web application using the Hummingbird command line tool ","type":"text"},{"type":"codeVoice","code":"hb"},{"text":".","type":"text"}],"type":"paragraph"}],"title":"Create a Hummingbird application."},{"kind":"tasks","tasks":[{"title":"Create your project","contentSection":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Download "},{"type":"codeVoice","code":"hb"},{"type":"text","text":" application, configure a project and review the contents of the generated project."}]}],"media":"hummingbird.png","mediaPosition":"trailing","kind":"contentAndMedia"}],"stepsSection":[{"content":[{"inlineContent":[{"type":"text","text":"Download "},{"type":"codeVoice","code":"hb"},{"type":"text","text":" command line tool using Homebrew"}],"type":"paragraph"}],"media":null,"type":"step","runtimePreview":null,"caption":[],"code":"todos-template-01.sh"},{"content":[{"inlineContent":[{"type":"text","text":"Create a new project using "},{"type":"codeVoice","code":"hb"},{"type":"text","text":". When asked, select “Server”, set the executable name to be “App” and press return on remaining questions to use the default values."}],"type":"paragraph"}],"media":null,"type":"step","runtimePreview":null,"caption":[],"code":"todos-template-02.sh"},{"content":[{"inlineContent":[{"type":"text","text":"Now lets review what has been setup. Open "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":"."}],"type":"paragraph"}],"media":null,"type":"step","runtimePreview":null,"caption":[{"inlineContent":[{"type":"text","text":"You can see if has dependencies for Hummingbird and the Apple’s Configuration library."}],"type":"paragraph"}],"code":"todos-template-03.swift"},{"content":[{"inlineContent":[{"type":"text","text":"Open "},{"type":"codeVoice","code":"Sources\/App\/App.swift"}],"type":"paragraph"}],"media":null,"type":"step","runtimePreview":null,"caption":[{"inlineContent":[{"type":"text","text":"This contains an "},{"type":"codeVoice","code":"App"},{"type":"text","text":" tagged with "},{"type":"codeVoice","code":"@main"},{"type":"text","text":". The "},{"type":"codeVoice","code":"main"},{"type":"text","text":" function in "},{"type":"codeVoice","code":"App"},{"type":"text","text":" sets up a "},{"type":"codeVoice","code":"ConfigReader"},{"type":"text","text":" to read configuration values from the command line arguments, environment variables, a "},{"type":"codeVoice","code":".env"},{"type":"text","text":" file and in-memory values in that order. Then it calls "},{"type":"codeVoice","code":"buildApplication(reader:)"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"ConfigReader"},{"type":"text","text":" to create an "},{"type":"codeVoice","code":"Application"},{"type":"text","text":" and runs it using "},{"type":"codeVoice","code":"runService()"},{"type":"text","text":". You can find out more about the Configuration library "},{"isActive":true,"type":"reference","identifier":"https:\/\/swiftpackageindex.com\/apple\/swift-configuration\/1.0.0\/documentation\/configuration"},{"type":"text","text":"."}],"type":"paragraph"}],"code":"todos-template-04.swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Open "},{"type":"codeVoice","code":"Sources\/App\/App+build.swift"},{"type":"text","text":" to find the `buildApplication(_:) function."}]}],"media":null,"type":"step","runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Here we create a "},{"type":"codeVoice","code":"Logger"},{"type":"text","text":" with log level extracted from the configuration reader mentioned above. We then call a function "},{"type":"codeVoice","code":"buildRouter()"},{"type":"text","text":" and use the result of that to create our "},{"type":"codeVoice","code":"Application"},{"type":"text","text":". The application uses configuration values "},{"type":"codeVoice","code":"HTTP_HOST"},{"type":"text","text":" and "},{"type":"codeVoice","code":"HTTP_PORT"},{"type":"text","text":" to define its bind address."}]}],"code":"todos-template-05.swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If we look further down the file we can find the "},{"code":"buildRouter()","type":"codeVoice"},{"type":"text","text":" function."}]}],"media":null,"type":"step","runtimePreview":null,"caption":[{"type":"paragraph","inlineContent":[{"text":"Here we create the ","type":"text"},{"type":"codeVoice","code":"Router"},{"text":". We add a logging middleware to it (this logs all requests to the router). The function uses a result builder to create a stack of middleware, but you can also use ","type":"text"},{"type":"codeVoice","code":"Router.add(middleware:)"},{"text":" to add individual middleware. Finally we add a single endpoint GET ","type":"text"},{"type":"codeVoice","code":"\/"},{"text":" which returns a String response: “Hello!”.","type":"text"}]}],"code":"todos-template-06.swift"},{"content":[{"inlineContent":[{"text":"We can run this application and use curl to test it works.","type":"text"}],"type":"paragraph"}],"media":null,"type":"step","runtimePreview":null,"caption":[],"code":"todos-template-07.sh"},{"content":[{"inlineContent":[{"text":"Now we have a running server, lets add some functionality to it.","type":"text"}],"type":"paragraph"}],"media":null,"type":"step","runtimePreview":null,"caption":[],"code":"todos-template-08.sh"}],"anchor":"Create-your-project"}]},{"action":{"overridingTitle":"Get started","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-2-API","isActive":true,"overridingTitleInlineContent":[{"text":"Get started","type":"text"}],"type":"reference"},"featuredEyebrow":"Tutorial","kind":"callToAction","abstract":[{"text":"Add some functionality to your application.","type":"text"}],"title":"Add your application API"}],"metadata":{"role":"project","categoryPathComponent":"Todos","category":"Todo backend","title":"Create a Hummingbird application."},"references":{"doc://com.opticalaberration.hummingbird/tutorials/Todos/Store-Todos-in-a-database":{"kind":"article","title":"Store Todos in a database","url":"\/tutorials\/todos\/store-todos-in-a-database","abstract":[],"type":"topic","role":"article","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Todos\/Store-Todos-in-a-database"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Todos-3-Testing":{"role":"project","title":"Testing your application","estimatedTime":"10min","type":"topic","kind":"project","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-3-Testing","abstract":[{"type":"text","text":"Test your application using the HummingbirdTesting framework"}],"url":"\/tutorials\/hummingbird\/todos-3-testing"},"doc://com.opticalaberration.hummingbird/tutorials/Todos/Application-Setup":{"kind":"article","title":"Application Setup","url":"\/tutorials\/todos\/application-setup","abstract":[],"type":"topic","role":"article","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Todos\/Application-Setup"},"hummingbird.png":{"identifier":"hummingbird.png","variants":[{"traits":["1x","light"],"url":"\/images\/com.opticalaberration.hummingbird\/hummingbird.png"}],"alt":"Hummingbird logo","type":"image"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Todos-2-API":{"role":"project","title":"Add your application API","estimatedTime":"15min","type":"topic","kind":"project","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-2-API","abstract":[{"type":"text","text":"Add some functionality to your application."}],"url":"\/tutorials\/hummingbird\/todos-2-api"},"doc://com.opticalaberration.hummingbird/tutorials/Todos/Testing-your-application":{"kind":"article","title":"Testing your application","url":"\/tutorials\/todos\/testing-your-application","abstract":[],"type":"topic","role":"article","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Todos\/Testing-your-application"},"todos-template-05.swift":{"syntax":"swift","fileType":"swift","content":["\/\/\/  Build application","\/\/\/ - Parameter reader: configuration reader","func buildApplication(reader: ConfigReader) async throws -> some ApplicationProtocol {","    let logger = {","        var logger = Logger(label: \"Todos\")","        logger.logLevel = reader.string(forKey: \"log.level\", as: Logger.Level.self, default: .info)","        return logger","    }()","    let router = try buildRouter()","    let app = Application(","        router: router,","        configuration: ApplicationConfiguration(reader: reader.scoped(to: \"http\")),","        logger: logger","    )","    return app","}"],"type":"file","identifier":"todos-template-05.swift","highlights":[],"fileName":"buildApplication() - Sources\/App\/App+build.swift"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Todos-1-Template":{"estimatedTime":"5min","kind":"project","title":"Create a Hummingbird application.","url":"\/tutorials\/hummingbird\/todos-1-template","abstract":[{"type":"text","text":"Create a simple web application using the Hummingbird command line tool "},{"code":"hb","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","role":"project","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-1-Template"},"doc://com.opticalaberration.hummingbird/tutorials/Todos":{"role":"overview","title":"Build a Todos application.","type":"topic","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Todos","kind":"overview","abstract":[{"type":"text","text":"A tutorial showing you how to build a simple Todos application that allows you to store, access, edit and delete Todos in a database, using Hummingbird and PostgresNIO."}],"url":"\/tutorials\/todos"},"todos-template-08.sh":{"syntax":"","fileType":"","content":["> curl -i localhost:8080","HTTP\/1.1 200 OK","Content-Type: text\/plain; charset=utf-8","Content-Length: 6","Date: Mon, 05 Jan 2026 11:29:04 GMT","Server: Todos","","Hello!"],"type":"file","identifier":"todos-template-08.sh","highlights":[{"line":2},{"line":3},{"line":4},{"line":5},{"line":6},{"line":7},{"line":8}],"fileName":"Test Application"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Todos-4-Postgres":{"estimatedTime":"15min","kind":"project","title":"Use PostgresNIO to store your Todos in a Postgres database","type":"topic","url":"\/tutorials\/hummingbird\/todos-4-postgres","abstract":[{"type":"text","text":"Now we have a working API and a way to test it, lets look into storing our todos in a Postgres database with PostgresNIO."}],"role":"project","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-4-Postgres"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Todos-4-Postgres#Setup-your-Postgres-database":{"role":"pseudoSymbol","title":"Setup your Postgres database","type":"section","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-4-Postgres#Setup-your-Postgres-database","kind":"section","abstract":[{"type":"text","text":"Now we have a working API and a way to test it, lets look into storing our todos in a Postgres database with PostgresNIO."}],"url":"\/tutorials\/hummingbird\/todos-4-postgres#Setup-your-Postgres-database"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Todos-2-API#Todo-Controller-and-Repository":{"kind":"section","title":"Todo Controller and Repository","type":"section","url":"\/tutorials\/hummingbird\/todos-2-api#Todo-Controller-and-Repository","abstract":[{"type":"text","text":"Add some functionality to your application."}],"role":"pseudoSymbol","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-2-API#Todo-Controller-and-Repository"},"todos-template-02.sh":{"syntax":"","fileType":"","content":["> hb init Todos","Downloading template version 2.6.0","Outputting to: \/Users\/adamfowler\/Developer\/server\/hummingbird-project\/template\/Todos","✔︎ What kind of application are you building: Server ","✔︎ What would you like your executable to be named?: App ","✔︎ Which features would you like to enable?:",""],"type":"file","identifier":"todos-template-02.sh","highlights":[],"fileName":"Create new project"},"todos-template-07.sh":{"fileName":"Test Application","syntax":"","content":["> curl -i localhost:8080"],"fileType":"","highlights":[],"type":"file","identifier":"todos-template-07.sh"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Todos-2-API#Testing-your-application-with-curl":{"role":"pseudoSymbol","title":"Testing your application with curl","kind":"section","type":"section","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-2-API#Testing-your-application-with-curl","abstract":[{"type":"text","text":"Add some functionality to your application."}],"url":"\/tutorials\/hummingbird\/todos-2-api#Testing-your-application-with-curl"},"https://swiftpackageindex.com/apple/swift-configuration/1.0.0/documentation/configuration":{"url":"https:\/\/swiftpackageindex.com\/apple\/swift-configuration\/1.0.0\/documentation\/configuration","type":"link","title":"here","identifier":"https:\/\/swiftpackageindex.com\/apple\/swift-configuration\/1.0.0\/documentation\/configuration","titleInlineContent":[{"type":"text","text":"here"}]},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Todos-4-Postgres#Setup-a-Postgres-repository":{"kind":"section","title":"Setup a Postgres repository","type":"section","url":"\/tutorials\/hummingbird\/todos-4-postgres#Setup-a-Postgres-repository","abstract":[{"type":"text","text":"Now we have a working API and a way to test it, lets look into storing our todos in a Postgres database with PostgresNIO."}],"role":"pseudoSymbol","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-4-Postgres#Setup-a-Postgres-repository"},"todos-template-06.swift":{"syntax":"swift","fileType":"swift","content":["\/\/\/ Build router","func buildRouter() -> Router<AppRequestContext> {","    let router = Router(context: AppRequestContext.self)","    \/\/ Add middleware","    router.addMiddleware {","        \/\/ logging middleware","        LogRequestsMiddleware(.info)","    }","    \/\/ Add default endpoint","    router.get(\"\/\") { _,_ in","        return \"Hello!\"","    }","    return router","}"],"type":"file","identifier":"todos-template-06.swift","highlights":[],"fileName":"buildRouter() - Sources\/App\/App+build.swift"},"todos-template-03.swift":{"fileName":"Package.swift","fileType":"swift","syntax":"swift","content":["\/\/ swift-tools-version:6.3","\/\/ The swift-tools-version declares the minimum version of Swift required to build this package.","","import PackageDescription","","let package = Package(","    name: \"Todos\",","    platforms: [.macOS(.v15), .iOS(.v18), .tvOS(.v18)],","    products: [","        .executable(name: \"App\", targets: [\"App\"]),","    ],","    dependencies: [","        .package(url: \"https:\/\/github.com\/hummingbird-project\/hummingbird.git\", from: \"2.25.0\"),","        .package(url: \"https:\/\/github.com\/apple\/swift-configuration.git\", from: \"1.0.0\", traits: [.defaults, \"CommandLineArguments\"]),","    ],","    targets: [","        .executableTarget(name: \"App\",","            dependencies: [","                .product(name: \"Configuration\", package: \"swift-configuration\"),","                .product(name: \"Hummingbird\", package: \"hummingbird\"),","            ],","            path: \"Sources\/App\"","        ),","        .testTarget(name: \"AppTests\",","            dependencies: [","                .byName(name: \"App\"),","                .product(name: \"HummingbirdTesting\", package: \"hummingbird\")","            ],","            path: \"Tests\/AppTests\"","        )","    ]",")"],"highlights":[],"type":"file","identifier":"todos-template-03.swift"},"todos-template-04.swift":{"syntax":"swift","fileType":"swift","content":["import Configuration","import Hummingbird","import Logging","","@main","struct App {","    static func main() async throws {","        \/\/ Application will read configuration from the following in the order listed","        \/\/ Command line, Environment variables, dotEnv file, defaults provided in memory ","        let reader = try await ConfigReader(providers: [","            CommandLineArgumentsProvider(),","            EnvironmentVariablesProvider(),","            EnvironmentVariablesProvider(environmentFilePath: \".env\", allowMissing: true),","            InMemoryProvider(values: [","                \"http.serverName\": \"Todos\"","            ])","        ])","        let app = try await buildApplication(reader: reader)","        try await app.runService()","    }","}"],"type":"file","identifier":"todos-template-04.swift","highlights":[],"fileName":"Sources\/App\/App.swift"},"todos-template-01.sh":{"fileName":"Download `hb`","fileType":"","syntax":"","content":["> brew install hummingbird-project\/tap\/hb"],"highlights":[],"type":"file","identifier":"todos-template-01.sh"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Todos-3-Testing#Project-testing-setup":{"role":"pseudoSymbol","title":"Project testing setup","kind":"section","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-3-Testing#Project-testing-setup","type":"section","abstract":[{"text":"Test your application using the HummingbirdTesting framework","type":"text"}],"url":"\/tutorials\/hummingbird\/todos-3-testing#Project-testing-setup"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Todos-3-Testing#Test-your-application":{"kind":"section","title":"Test your application","url":"\/tutorials\/hummingbird\/todos-3-testing#Test-your-application","abstract":[{"text":"Test your application using the HummingbirdTesting framework","type":"text"}],"type":"section","role":"pseudoSymbol","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-3-Testing#Test-your-application"},"doc://com.opticalaberration.hummingbird/tutorials/Todos/API-Setup":{"role":"article","title":"API Setup","kind":"article","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Todos\/API-Setup","type":"topic","abstract":[],"url":"\/tutorials\/todos\/api-setup"},"doc://com.opticalaberration.hummingbird/tutorials/Hummingbird/Todos-1-Template#Create-your-project":{"kind":"section","title":"Create your project","url":"\/tutorials\/hummingbird\/todos-1-template#Create-your-project","abstract":[{"text":"Create a simple web application using the Hummingbird command line tool ","type":"text"},{"code":"hb","type":"codeVoice"},{"text":".","type":"text"}],"type":"section","role":"pseudoSymbol","identifier":"doc:\/\/com.opticalaberration.hummingbird\/tutorials\/Hummingbird\/Todos-1-Template#Create-your-project"}}}