de":"failedJobs"},{"type":"text","text":", "},{"type":"codeVoice","code":"completedJobs"},{"type":"text","text":", "},{"type":"codeVoice","code":"cancelledJobs"},{"type":"text","text":" or "},{"type":"codeVoice","code":"pausedJobs"},{"type":"text","text":" set"},{"type":"text","text":" "},{"type":"text","text":"to whatever you like at any point to re-queue failed jobs. Moving processing or pending jobs"},{"type":"text","text":" "},{"type":"text","text":"should only be done if you are certain there is nothing processing the job queue."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"pendingJobs: What to do with jobs tagged as pending"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"processingJobs: What to do with jobs tagged as processing"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"completedJobs: What to do with jobs tagged as completed"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"failedJobs: What to do with jobs tagged as failed","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"cancelledJobs: What to do with jobs tagged as cancelled"}]}]},{"content":[{"inlineContent":[{"text":"pausedJobs: What to do with jobs tagged as paused","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"logger: Optional logger to use when performing cleanup"}]}]}],"type":"unorderedList"},{"name":"Throws","content":[{"inlineContent":[{"text":"","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/jobspostgres\/postgresjobqueue\/cleanup(pendingjobs:processingjobs:completedjobs:failedjobs:cancelledjobs:pausedjobs:logger:)"]}],"metadata":{"role":"symbol","externalID":"s:12JobsPostgres0B8JobQueueC7cleanup07pendingA0010processingA009completedA006fail