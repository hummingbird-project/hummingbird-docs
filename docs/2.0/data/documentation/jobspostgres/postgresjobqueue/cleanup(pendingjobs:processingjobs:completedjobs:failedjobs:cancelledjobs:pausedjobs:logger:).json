tgres\/PostgresJobQueue\/JobCleanup","kind":"typeIdentifier","text":"JobCleanup"},{"kind":"text","text":" = .doNothing, "},{"kind":"externalParam","text":"cancelledJobs"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12JobsPostgres0B8JobQueueC0C7CleanupV","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresJobQueue\/JobCleanup","kind":"typeIdentifier","text":"JobCleanup"},{"kind":"text","text":" = .doNothing, "},{"kind":"externalParam","text":"pausedJobs"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12JobsPostgres0B8JobQueueC0C7CleanupV","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresJobQueue\/JobCleanup","kind":"typeIdentifier","text":"JobCleanup"},{"kind":"text","text":" = .doNothing, "},{"kind":"externalParam","text":"logger"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7Logging6LoggerV","kind":"typeIdentifier","text":"Logger"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"platforms":["Linux"],"languages":["swift"]}]},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"This function is used to re-run or delete jobs in a certain state. Failed, completed,"},{"type":"text","text":" "},{"type":"text","text":"cancelled and paused jobs can be pushed back into the pending queue to be re-run or removed."},{"type":"text","text":" "},{"type":"text","text":"When called at startup in theory no job should be set to processing, or set to pending but"},{"type":"text","text":" "},{"type":"text","text":"not in the queue. but if your job server crashes these states are possible, so we also provide"},{"type":"text","text":" "},{"type":"text","text":"options to re-queue these jobs so they are run again."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You can call "},{"type":"codeVoice","code":"cleanup"},{"type":"text","text":" with "},{"type":"codeVoice","code":"failedJobs"},{"type":"text","text":", "},{"type":"codeVoice","code":"completedJobs"},{"type":"text","text":", "},{"type":"codeVoice","code":"cancelledJobs"},{"type":"text","text":" or "},{"type":"codeVoice","code":"pausedJobs"},{"type":"text","text":" set"},{"type":"text","text":" "},{"type":"text","text":"to whatever you like at any point to re-queue failed jobs. Moving processing or pending jobs"},{"type":"text","text":" "},{"type":"text","text":"should only be done if you are certain there is nothing processing the job queue."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"pendingJobs: What to do with jobs tagged as pending","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"processingJobs: What to do with jobs tagged as processing","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"completedJobs: What to do with jobs tagged as completed"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"failedJobs: What to do with jobs tagged as failed"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"cancelledJobs: What to do with jobs tagged as cancelled"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"pausedJobs: What to do with jobs tagged as paused"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"logger: Optional logger to use when performing cleanup"}]}]}]},{"type":"aside","name":"Throws","style":"note","content":[{"inlineContent":[{"type":"text","text":""}],"type":"paragraph"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/jobspostgres\/postgresjobqueue\/cleanup(pendingjobs:processingjobs:completedjobs:failedjobs:cancelledjobs:pausedjobs:logger:)"]}],"metadata":{"role":"symbol","symbolKind":"method","title":"cleanup