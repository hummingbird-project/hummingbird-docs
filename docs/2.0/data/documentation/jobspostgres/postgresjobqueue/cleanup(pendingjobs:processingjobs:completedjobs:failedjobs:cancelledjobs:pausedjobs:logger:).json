xt","text":" "},{"type":"text","text":"not in the queue. but if your job server crashes these states are possible, so we also provide"},{"type":"text","text":" "},{"type":"text","text":"options to re-queue these jobs so they are run again."}]},{"type":"paragraph","inlineContent":[{"text":"You can call ","type":"text"},{"code":"cleanup","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"failedJobs","type":"codeVoice"},{"text":", ","type":"text"},{"code":"completedJobs","type":"codeVoice"},{"text":", ","type":"text"},{"code":"cancelledJobs","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"pausedJobs","type":"codeVoice"},{"text":" set","type":"text"},{"text":" ","type":"text"},{"text":"to whatever you like at any point to re-queue failed jobs. Moving processing or pending jobs","type":"text"},{"text":" ","type":"text"},{"text":"should only be done if you are certain there is nothing processing the job queue.","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"pendingJobs: What to do with jobs tagged as pending","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"processingJobs: What to do with jobs tagged as processing","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"completedJobs: What to do with jobs tagged as completed","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"failedJobs: What to do with jobs tagged as failed","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"cancelledJobs: What to do with jobs tagged as cancelled","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"pausedJobs: What to do with jobs tagged as paused","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"logger: Optional logger to use when performing cleanup","type":"text"}],"type":"paragraph"}]}]},{"name":"Throws","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"