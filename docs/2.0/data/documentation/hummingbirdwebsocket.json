{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hummingbirdwebsocket"]}],"sections":[],"primaryContentSections":[{"mentions":["doc:\/\/com.opticalaberration.hummingbird\/documentation\/Hummingbird\/WebSocketServerUpgrade"],"kind":"mentions"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"WebSockets is a protocol providing simultaneous two-way communication channels over a single TCP connection. Unlike HTTP where client requests are paired with a server response, WebSockets allow for communication in both directions asynchronously, for a prolonged period of time."}]},{"type":"paragraph","inlineContent":[{"text":"It is designed to work over the HTTP ports 80 and 443 via an upgrade process where an initial HTTP request is sent before the connection is upgraded to a WebSocket connection.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"HummingbirdWebSocket allows you to implement an HTTP1 server with WebSocket upgrade. HummingbirdWebSocket passes all the tests in the "},{"type":"reference","identifier":"https:\/\/github.com\/crossbario\/autobahn-testsuite","isActive":true},{"type":"text","text":", supporting both compression and TLS."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add "},{"type":"codeVoice","code":"HummingbirdWebSocket"},{"type":"text","text":" to your project, run the following command in your Terminal:"}]},{"syntax":"sh","type":"codeListing","code":["# From the root directory of your project","# Where Package.swift is located","","# Add the package to your dependencies","swift package add-dependency https:\/\/github.com\/hummingbird-project\/hummingbird-websocket.git --from 2.2.0","","# Add the target dependency to your target","swift package add-target-dependency HummingbirdWebSocket <MyApp> --package hummingbird-websocket"]},{"type":"paragraph","inlineContent":[{"text":"Make sure to replace ","type":"text"},{"type":"codeVoice","code":"<MyApp>"},{"text":" with the name of your App’s target.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To integrate "},{"type":"codeVoice","code":"HummingbirdWebSocket"},{"type":"text","text":" into your project, you need to specify WebSocket support in your "},{"type":"codeVoice","code":"Application"},{"type":"text","text":"’s configuration:"}]},{"syntax":"swift","type":"codeListing","code":["import Hummingbird","import HummingbirdWebSocket","","let app = Application(","    router: router,","    server: .http1WebSocketUpgrade { request, channel, logger in","        \/\/ upgrade if request URI is \"\/ws\"","        guard request.uri == \"\/ws\" else { return .dontUpgrade }","        \/\/ The upgrade response includes the headers to include in the response and ","        \/\/ the WebSocket handler","        return .upgrade([:]) { inbound, outbound, context in","            \/\/ Send \"Hello\" to the client","            try await outbound.write(.text(\"Hello\"))","            \/\/ Ending this function automatically closes the connection","        }","    }",")"]},{"type":"paragraph","inlineContent":[{"text":"Get started with the WebSockets here: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Hummingbird\/WebSocketServerUpgrade"}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Adds support for upgrading HTTP connections to WebSocket."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/HummingbirdWebSocket","interfaceLanguage":"swift"},"hierarchy":{"paths":[[]]},"kind":"symbol","seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/com.opticalaberration.hummingbird\/documentation\/WSCompression","doc:\/\/com.opticalaberration.hummingbird\/documentation\/HummingbirdWS