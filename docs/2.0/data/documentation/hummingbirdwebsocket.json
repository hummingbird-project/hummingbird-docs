{"primaryContentSections":[{"kind":"mentions","mentions":["doc:\/\/com.opticalaberration.hummingbird\/documentation\/Hummingbird\/WebSocketServerUpgrade"]},{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"WebSockets is a protocol providing simultaneous two-way communication channels over a single TCP connection. Unlike HTTP where client requests are paired with a server response, WebSockets allow for communication in both directions asynchronously, for a prolonged period of time."}],"type":"paragraph"},{"inlineContent":[{"text":"It is designed to work over the HTTP ports 80 and 443 via an upgrade process where an initial HTTP request is sent before the connection is upgraded to a WebSocket connection.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"HummingbirdWebSocket allows you to implement an HTTP1 server with WebSocket upgrade. HummingbirdWebSocket passes all the tests in the ","type":"text"},{"identifier":"https:\/\/github.com\/crossbario\/autobahn-testsuite","type":"reference","isActive":true},{"text":", supporting both compression and TLS.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To add ","type":"text"},{"code":"HummingbirdWebSocket","type":"codeVoice"},{"text":" to your project, run the following command in your Terminal:","type":"text"}],"type":"paragraph"},{"syntax":"sh","code":["# From the root directory of your project","# Where Package.swift is located","","# Add the package to your dependencies","swift package add-dependency https:\/\/github.com\/hummingbird-project\/hummingbird-websocket.git --from 2.2.0","","# Add the target dependency to your target","swift package add-target-dependency HummingbirdWebSocket <MyApp> --package hummingbird-websocket"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Make sure to replace "},{"type":"codeVoice","code":"<MyApp>"},{"type":"text","text":" with the name of your App’s target."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To integrate "},{"type":"codeVoice","code":"HummingbirdWebSocket"},{"type":"text","text":" into your project, you need to specify WebSocket support in your "},{"type":"codeVoice","code":"Application"},{"type":"text","text":"’s configuration:"}],"type":"paragraph"},{"syntax":"swift","code":["import Hummingbird","import HummingbirdWebSocket","","let app = Application(","    router: router,","    server: .http1WebSocketUpgrade { request, channel, logger in","        \/\/ upgrade if request URI is \"\/ws\"","        guard request.uri == \"\/ws\" else { return .dontUpgrade }","        \/\/ The upgrade response includes the headers to include in the response and ","        \/\/ the WebSocket handler","        return .upgrade([:]) { inbound, outbound, context in","            \/\/ Send \"Hello\" to the client","            try await outbound.write(.text(\"Hello\"))","            \/\/ Ending this function automatically closes the connection","        }","    }",")"],"type":"codeListing"},{"inlineContent":[{"text":"Get started with the WebSockets here: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Hummingbird\/WebSocketServerUpgrade","type":"reference"}],"type":"paragraph"}]}],"hierarchy":{"paths":[[]]},"abstract":[{"text":"Adds support for upgrading HTTP connections to WebSocket.","type":"text"}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"variants":[{"paths":["\/documentation\/hummingbirdwebsocket"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Server","identifiers":["doc:\/\/com.opticalaberration.hummingbird\/documentation\/HummingbirdCore\/HTTPServerBuilder\/http1WebSocketUpgrade(configuration:additionalChannelHandlers:shouldUpgrade:)-3n8zf","doc:\/\/com.opticalaberration.hummingbird\/documentation\/HummingbirdCore\/HTTPServerBuilder\/http1WebSocketUpgrade(configuration:additionalChann