{"topicSections":[{"identifiers":["doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresJobQueue"],"anchor":"Job-Queue","title":"Job Queue"},{"identifiers":["doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresJobCleanupParameters","doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresOrphanedJobCleanupParameters"],"anchor":"Structures","generated":true,"title":"Structures"},{"identifiers":["doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresProcessingJobCleanupParameters"],"anchor":"Type-Aliases","generated":true,"title":"Type Aliases"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"identifier":{"url":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres","interfaceLanguage":"swift"},"abstract":[{"text":"Postgres implementation for swift-jobs framework","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs","doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsValkey","doc:\/\/com.opticalaberration.hummingbird\/documentation\/Hummingbird","doc:\/\/com.opticalaberration.hummingbird\/documentation\/HummingbirdPostgres"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsValkey"],"anchor":"Reference","generated":true,"title":"Reference"}],"variants":[{"paths":["\/documentation\/jobspostgres"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"mentions","mentions":["doc:\/\/com.opticalaberration.hummingbird\/documentation\/Hummingbird\/MigrationsGuide"]},{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"JobsPostgres provides a swift-jobs Queue driver using "},{"type":"reference","identifier":"https:\/\/api.vapor.codes\/postgresnio\/documentation\/postgresnio\/","isActive":true},{"type":"text","text":" and the "},{"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/PostgresMigrations","isActive":true},{"type":"text","text":" library."}],"type":"paragraph"},{"anchor":"Setup","level":2,"type":"heading","text":"Setup"},{"inlineContent":[{"text":"The Postgres job queue driver uses ","type":"text"},{"type":"codeVoice","code":"PostgresClient"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"PostgresNIO"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/PostgresMigrations\/DatabaseMigrations"},{"text":" from the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/PostgresMigrations"},{"text":" library to perform the database migrations needed for the driver.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The Postgres job queue configuration includes three values.","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"pollTime"},{"type":"text","text":": This is the amount of time between the last time the queue was empty and the next time the driver starts looking for pending jobs."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"queueName"},{"text":": Name of queue used to differentiate itself from other queues.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"retentionPolicy","type":"codeVoice"},{"type":"text","text":": Policy on whether to retain or delete completed, failed and cancelled jobs."}]}]}]},{"type":"codeListing","code":["import JobsPostgres","import PostgresNIO","import ServiceLifecycle","","let postgresClient = PostgresClient(...)","let postgresMigrations = DatabaseMigrations()","let jobService = JobService(","    .postgres(","        client: postgresClient,","        migrations: postgresMigrations,","        configuration: .init(","            pollTime: .milliseconds(50),","            queueName: \"MyJobQueue\"","        ),","        logger: logger","    ), ","    logger: logger",")"],"syntax":"swift"},{"inlineContent":[{"text":"The easiest way to ensure the migrations are run is to use the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/PostgresMigrations\/DatabaseMigrationService","type":"reference"},{"text":" and add that as a ","type":"text"},{"code":"Service","type":"codeVoice"},{"text":" to your ","type":"text"},{"code":"ServiceGroup","type":"codeVoice"},{"text":". The job queue service will not run until the migrations have been run in either ","type":"text"},{"code":"dryRun","type":"codeVoice"},{"text":" mode or for real.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let migrationService = DatabaseMigrationService(","    client: postgresClient,","    migrations: postgresMigrations,","    logger: logger,","    dryRun: false",")","let serviceGroup = ServiceGroup(","    configuration: .init(","        services: [postgresClient, migrationService, jobService],","        gracefulShutdownSignals: [.sigterm, .sigint],","        logger: jobService.logger","    )",")","try await serviceGroup.run()"],"syntax":"swift"},{"anchor":"Additional-Features","level":2,"type":"heading","text":"Additional Features"},{"inlineContent":[{"text":"There are features specific to the Postgres Job Queue implementation. Some of these are available in other queues and others not.","type":"text"}],"type":"paragraph"},{"anchor":"Push-Options","level":3,"type":"heading","text":"Push Options"},{"inlineContent":[{"type":"text","text":"When pushing a job to the queue there are a couple of options you can provide."}],"type":"paragraph"},{"anchor":"Delaying-jobs","level":4,"type":"heading","text":"Delaying jobs"},{"inlineContent":[{"text":"As with all queue drivers you can add a delay before a job is processed. The job will sit in the pending queue and will not be available for processing until time has passed its delay until time.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Add TestJob to the queue, but don't process it for 2 minutes","try await jobService.push(TestJob(), options: .init(delayUntil: .now + 120))"],"syntax":"swift"},{"anchor":"Job-Priority","level":4,"type":"heading","text":"Job Priority"},{"inlineContent":[{"type":"text","text":"The postgres queue allows you to give a job a priority. Jobs with higher priorities are run before jobs with lower priorities. There are five priorities "},{"type":"codeVoice","code":".lowest"},{"type":"text","text":", "},{"type":"codeVoice","code":".lower"},{"type":"text","text":", "},{"type":"codeVoice","code":".normal"},{"type":"text","text":", "},{"type":"codeVoice","code":".higher"},{"type":"text","text":" and "},{"type":"codeVoice","code":".highest"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Add BackgroundJob to the queue. It will only get processed if there are no jobs","\/\/ with a higher priority on the queue.","try await jobService.push(BackgroundJob(), options: .init(priority: .lowest))"],"syntax":"swift"},{"anchor":"Cancellation","level":3,"type":"heading","text":"Cancellation"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresJobQueue"},{"type":"text","text":" conforms to protocol "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/CancellableJobQueue"},{"type":"text","text":". This requires support for cancelling jobs that are in the pending queue. It adds one new function "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresJobQueue\/cancel(jobID:)"},{"type":"text","text":". If you supply this function with the "},{"type":"codeVoice","code":"JobID"},{"type":"text","text":" returned by "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresJobQueue\/push(_:options:)"},{"type":"text","text":" it will remove it from the pending queue."}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Add TestJob to the queue and immediately cancel it","let jobID = try await jobService.push(TestJob(), options: .init(delayUntil: .now + 120))","try await jobService.cancel(jobID: jobID)"],"syntax":"swift"},{"anchor":"Pause-and-Resume","level":3,"type":"heading","text":"Pause and Resume"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresJobQueue","type":"reference","isActive":true},{"text":" conforms to protocol ","type":"text"},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/ResumableJobQueue","type":"reference","isActive":true},{"text":". This requires support for pausing and resuming jobs that are in the pending queue. It adds two new functions ","type":"text"},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresJobQueue\/pause(jobID:)","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresJobQueue\/resume(jobID:)","type":"reference","isActive":true},{"text":". If you supply these function with the ","type":"text"},{"type":"codeVoice","code":"JobID"},{"text":" returned by ","type":"text"},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresJobQueue\/push(_:options:)","type":"reference","isActive":true},{"text":" you can remove from the pending queue and add them back in at a later date.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Add TestJob to the queue and immediately remove it and then add it back to the queue","let jobID = try await jobService.push(TestJob(), options: .init(delayUntil: .now + 120))","try await jobService.pause(jobID: jobID)","try await jobService.resume(jobID: jobID)"],"syntax":"swift"},{"anchor":"Job-retention","level":3,"type":"heading","text":"Job retention"},{"inlineContent":[{"type":"text","text":"The queue has options to retain jobs once it has finished with them depending on status. By default the queue will retain failed jobs and drop cancelled or completed jobs, but these decisions are configurable."}],"type":"paragraph"},{"type":"codeListing","code":["let jobService = JobService(","    .postgres(","        client: postgresClient,","        migrations: postgresMigrations,","        configuration: .init(","            queueName: \"MyJobQueue\", ","            retentionPolicy: .init(","                completedJobs: .retain, ","                failedJobs: .retain, ","                cancelledJobs: .doNotRetain","            )","        ),","        logger: logger","    ),","    logger: logger",")"],"syntax":"swift"},{"anchor":"Job-queue-cleanup","level":3,"type":"heading","text":"Job queue cleanup"},{"inlineContent":[{"type":"text","text":"If you opt to retain jobs after processing you will probably eventually want to clean them up eventually. The Postgres queue provides a method "},{"type":"codeVoice","code":"cleanup"},{"type":"text","text":" which allows you to remove or attempt to re-run jobs based on what state they are in. You should be careful not to do anything to pending or processing jobs while the job queue is being processed as it might confuse the job processor."}],"type":"paragraph"},{"type":"codeListing","code":["jobService.queue.queue.cleanup(","    pendingJobs: .doNothing,","    processingJobs: .doNothing,","    completedJobs: .remove(maxAge: .seconds(7*24*60*60)),","    failedJobs: .rerun,","    cancelledJobs: .remove, ",")"],"syntax":"swift"},{"anchor":"Scheduling-cleanup","level":4,"type":"heading","text":"Scheduling cleanup"},{"inlineContent":[{"text":"Given this is a job you will probably want to do regularly the queue also provides a job you can use in conjunction with the ","type":"text"},{"type":"codeVoice","code":"JobScheduler"},{"text":" that will do the cleanup for you. There are options to set this up at initialization of your ","type":"text"},{"type":"codeVoice","code":"JobService"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let jobService = JobService(","    .postgres(...),","    logger: logger,","    options: .init(","        cleanup: .init(","            jobs: .init(","                parameters: .init(completedJobs: .remove(maxAge: .seconds(60*60*24*7))),","                schedule: .weekly(day: .sunday)","            )","        )","    )",")"],"syntax":"swift"}]}],"metadata":{"roleHeading":"Framework","images":[{"type":"icon","identifier":"logo.png"}],"title":"JobsPostgres","modules":[{"name":"JobsPostgres"}],"externalID":"JobsPostgres","symbolKind":"module","role":"collection"},"kind":"symbol","hierarchy":{"paths":[[]]},"references":{"doc://com.opticalaberration.hummingbird/documentation/JobsPostgres/PostgresJobCleanupParameters":{"kind":"symbol","navigatorTitle":[{"text":"PostgresJobCleanupParameters","kind":"identifier"}],"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresJobCleanupParameters","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PostgresJobCleanupParameters","kind":"identifier"}],"title":"PostgresJobCleanupParameters","role":"symbol","type":"topic","url":"\/documentation\/jobspostgres\/postgresjobcleanupparameters","abstract":[{"type":"text","text":"Parameters for Cleanup job"}]},"doc://com.opticalaberration.hummingbird/documentation/JobsPostgres/PostgresJobQueue":{"navigatorTitle":[{"kind":"ident