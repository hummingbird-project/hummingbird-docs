text":": ","kind":"text"},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsValkey\/ValkeyJobQueue\/JobCleanup","text":"JobCleanup","kind":"typeIdentifier","preciseIdentifier":"s:10JobsValkey0B8JobQueueC0C7CleanupV"},{"text":" = .doNothing, ","kind":"text"},{"text":"cancelledJobs","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsValkey\/ValkeyJobQueue\/JobCleanup","text":"JobCleanup","kind":"typeIdentifier","preciseIdentifier":"s:10JobsValkey0B8JobQueueC0C7CleanupV"},{"text":" = .doNothing, ","kind":"text"},{"text":"pausedJobs","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsValkey\/ValkeyJobQueue\/JobCleanup","text":"JobCleanup","kind":"typeIdentifier","preciseIdentifier":"s:10JobsValkey0B8JobQueueC0C7CleanupV"},{"text":" = .doNothing) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"pendingJobs","content":[{"inlineContent":[{"type":"text","text":"What to do with jobs tagged as pending"}],"type":"paragraph"}]},{"name":"processingJobs","content":[{"inlineContent":[{"text":"What to do with jobs tagged as processing","type":"text"}],"type":"paragraph"}]},{"name":"completedJobs","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What to do with jobs tagged as completed"}]}]},{"name":"failedJobs","content":[{"inlineContent":[{"text":"What to do with jobs tagged as failed","type":"text"}],"type":"paragraph"}]},{"name":"cancelledJobs","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What to do with jobs tagged as cancelled"}]}]},{"name":"pausedJobs","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"What to do with jobs tagged as cancelled"}]}]}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"This function is used to re-run or delete jobs in a certain state. Failed, completed,","type":"text"},{"text":" ","type":"text"},{"text":"cancelled and paused jobs can be pushed back into the pending queue to be re-run or removed.","type":"text"},{"text":" ","type":"text"},{"text":"When called at startup in theory no job should be set to processing, or set to pending but","type":"text"},{"text":" ","type":"text"},{"text":"not in the queue. but if your job server crashes these states are possible, so we also provide","type":"text"},{"text":" ","type":"text"},{"text":"options to re-queue these jobs so they are run again.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can call "},{"type":"codeVoice","code":"cleanup"},{"type":"text","text":" with "},{"type":"codeVoice","code":"failedJobs"},{"type":"text","text":", "},{"type":"codeVoice","code":"completedJobs"},{"type":"text","text":", "},{"type":"codeVoice","code":"cancelledJobs"},{"type":"text","text":" or "},{"type":"codeVoice","code":"pausedJobs"},{"type":"text","text":" set"},{"type":"text","text":" "},{"type":"text","text":"to whatever you like at any point to re-queue failed jobs. Moving processing or pending jobs"},{"type":"text","text":" "},{"type":"text","text":"should only be done if you are certain there is nothing processing the job queue."}]},{"content":[{"inlineContent":[{"type":"text","text":""}],"type":"paragraph"}],"type":"aside","style":"note","name":"Throws"}],"kind":"content"}],"references":{"doc://com.opticalaberration.hummingbird/documentation/JobsValkey/ValkeyJobQueue":{"type":"topic","title":"ValkeyJobQueue","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"ValkeyJobQueue"}],"kind":"symbol","url":"\/documentation\/jobsvalkey\/valkeyjobqueue","abstract":[{"type":"text","text":"Valkey implementation of job queu