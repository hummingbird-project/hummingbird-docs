{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/hummingbird\/jobsguide"]}],"metadata":{"title":"Jobs","roleHeading":"API Collection","modules":[{"name":"Jobs"}],"images":[{"type":"icon","identifier":"logo.png"}],"role":"collectionGroup"},"abstract":[{"text":"Durable job execution. Offload work your server would be doing to another server.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.opticalaberration.hummingbird\/documentation\/index"],["doc:\/\/com.opticalaberration.hummingbird\/documentation\/index","doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs"]]},"topicSections":[{"identifiers":["doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsValkey","doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres"],"title":"Reference","anchor":"Reference"}],"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A Job consists of a payload and an execute method to run the job. Swift Jobs provides a framework for pushing jobs onto a queue and processing them at a later point. If the driver backing up the job queue uses persistent storage then a separate server can be used to process the jobs.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs","isActive":true,"type":"reference"},{"type":"text","text":" framework comes with a driver that stores jobs in local memory and processes them locally, but this should only ever be used for debugging purposes. A production grade server should use one of "},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsValkey","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres","isActive":true,"type":"reference"},{"type":"text","text":" that implement the job queue using a Valkey\/Redis database or Postgres database respectively."}]},{"text":"Getting started","type":"heading","level":2,"anchor":"Getting-started"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Job queue support can be found in the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/hummingbird-project\/swift-jobs"},{"type":"text","text":" repository. To add the library as a dependency in your project use the following command line."}]},{"type":"codeListing","code":["swift package add-dependency https:\/\/github.com\/hummingbird-project\/swift-jobs.git --from \"1.1.0\""],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add the target dependency to your application use the following, replacing the "},{"type":"codeVoice","code":"<MyApp>"},{"type":"text","text":" text with the name of your application target."}]},{"type":"codeListing","code":["swift package add-target-dependency Jobs <MyApp> --package swift-jobs"],"syntax":null},{"anchor":"Setting-up-a-Job-service","type":"heading","level":3,"text":"Setting up a Job service"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To process jobs a JobService is needed. "},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/JobService","type":"reference","isActive":true},{"type":"text","text":" combines a job queue, job queue processor and job scheduler into one type. Below we create a job service using the Valkey driver for swift-jobs."}]},{"type":"codeListing","code":["let jobService = JobService(","    .valkey(","        valkeyClient, ","        configuration: .init(queueName: \"MyQueue\"),","        logger: logger","    ),","    logger: logger",")"],"syntax":"swift"},{"anchor":"Creating-a-Job-Definition","type":"heading","level":3,"text":"Creating a Job Definition"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Creating a job definition requires an identifier, the parameters for the job and the function that runs the job. We use a struct conforming to "},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/JobParameters","type":"reference","isActive":true},{"type":"text","text":" to define the job parameters and identifier."}]},{"type":"codeListing","code":["struct SendEmailJobParameters: JobParameters {","    \/\/\/ jobName is used to create the job identifier. It should be unique","    static let jobName = \"SendEmail\"","    let to: String","    let subject: String","    let body: String","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Then we register the job with a job queue and also provide a closure that executes the job.","type":"text"}]},{"type":"codeListing","code":["jobService.registerJob(parameters: SendEmailJobParameters.self) { parameters, context in","    try await myEmailService.sendEmail(to: parameters.to, subject: parameters.subject, body: parameters.body)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Now your job is ready to create. Jobs can be queued up using the function ","type":"text"},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/JobService\/push(_:options:)","isActive":true,"type":"reference"},{"text":" from ","type":"text"},{"code":"JobService","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","code":["let job = SendEmailJobParameters(","    to: \"joe@email.com\",","    subject: \"Testing Jobs\",","    message: \"...\"",")","jobService.push(job)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Alternatively you can create a job using a ","type":"text"},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/JobName","type":"reference","isActive":true},{"text":". This associates a type with a name, but that type can be used multiple times with different job names. Remember each job should have a unique job name.","type":"text"}]},{"type":"codeListing","code":["let printStringJob = JobName<String>(\"Print String\")","jobService.registerJob(printStringJob) { parameters, context in","    print(parameters)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"You then queue your job for execution using "},{"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/JobQueue\/push(_:parameters:options:)","isActive":true}]},{"type":"codeListing","code":["jobService.push(printStringJob, parameters: \"Testing,testing,1,2,3\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A common way to do this is to extend ","type":"text"},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/JobName","isActive":true,"type":"reference"},{"text":" with a static variable to aid autocomplete.","type":"text"}]},{"type":"codeListing","code":["extension JobName where Parameters == String {","    static var printString: Self { .init(\"Print String\") }","}","jobService.registerJob(.printString) { parameters, context in","    print(parameters)","}","jobService.push(.printString, parameters: \"Testing,testing,1,2,3\")"],"syntax":"swift"},{"anchor":"Processing-Jobs","type":"heading","level":3,"text":"Processing Jobs"},{"type":"paragraph","inlineContent":[{"text":"To start processing jobs you need to run the job queue processor. You can do this using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/JobService\/run()","type":"reference"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"JobService"},{"text":", although it is preferable to use ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/swift-server\/swift-service-lifecycle","type":"reference"},{"text":" to manage the running of the processor to ensure clean shutdown when your application is shutdown. You can control how many jobs the job queue processor runs concurrently, via options setup when initializing the ","type":"text"},{"type":"codeVoice","code":"JobService"},{"text":".","type":"text"}]},{"type":"codeListing","code":["let jobService = JobService(","    .valkey(","        valkeyClient, ","        configuration: .init(queueName: \"MyQueue\"),","        logger: logger","    ),","    logger: logger,","    options: .init(processor: .init(numWorkers: 64))",")","let serviceGroup = ServiceGroup(","    services: [server, jobService],","    configuration: .init(gracefulShutdownSignals: [.sigterm, .sigint]),","    logger: logger",")","try await serviceGroup.run()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you are running a Hummingbird server you can add the job processor to the array of services that "},{"code":"Application","type":"codeVoice"},{"type":"text","text":" manages."}]},{"type":"codeListing","code":["let app = Application(...)","app.addServices(jobService)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you want to process jobs on a separate server you will need to use a job queue driver that saves to some external storage eg "},{"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsValkey\/ValkeyJobQueue","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresJobQueue","isActive":true},{"type":"text","text":"."}]},{"anchor":"Retrying-Jobs","type":"heading","level":3,"text":"Retrying Jobs"},{"type":"paragraph","inlineContent":[{"text":"When a job fails most swift-job drivers save them separately so you can manually retry them at a later date. But you can also automate retrying of a failed job by defining a retry strategy for it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The retry strategy is defined at the point you create a job. By default this is set to "},{"code":".dontRetry","type":"codeVoice"},{"type":"text","text":" which will not attempt to retry a failed job. Swift-jobs provides a standard retry strategy "},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/ExponentialJitterJobRetryStrategy","type":"reference","isActive":true},{"type":"text","text":" where the backoff between each retry exponentially increases with a random jitter applied. The retry strategy for a job is defined at the same time you create a "},{"code":"JobDefinition","type":"codeVoice"},{"type":"text","text":" or when you register a job handler using "},{"code":"jobQueue.registerJob()","type":"codeVoice"},{"type":"text","text":". As an alternative to "},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/ExponentialJitterJobRetryStrategy","type":"reference","isActive":true},{"type":"text","text":", the shorthand "},{"code":".exponentialJitter()","type":"codeVoice"},{"type":"text","text":" is available."}]},{"type":"codeListing","code":["let emailJob = JobDefinition(","    parameters: SendEmailJobParameters.self, ","    retryStrategy: .exponentialJitter(","        maxAttempts: 4, \/\/ number of times to retry","        maxBackoff: 60, \/\/ maximum when calculating the backoff ","        minJitter: -0.25, \/\/ min jitter as a ratio of calculated backoff","        maxJitter: 0.33 \/\/ max jitter as a ratio of calculated backoff","    )",") { parameters, context in","    try sendEmail(parameters)","}","jobService.registerJob(emailJob)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/JobRetryStrategy","type":"reference"},{"text":" is a protocol. So you can define your own retry strategies as well.","type":"text"}]},{"type":"codeListing","code":["struct MyRetryStrategy: JobRetryStrategy {","    \/\/\/ Should we retry a failed job","    func shouldRetry(attempt: Int, error: any Error) -> Bool {","        isItSunday()","    }","","    \/\/\/  Calculate backoff amount","    func calculateBackoff(attempt: Int) -> Duration {","        .seconds(60*60*24)","    }","}"],"syntax":"swift"},{"anchor":"Sleeping-jobs","type":"heading","level":3,"text":"Sleeping jobs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a job starts and the resources it relies on are not ready, or you want to reschedule a job based on some other condition, you can get the job to sleep for a specified period and attempt at a later point using the "},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/JobSleep","isActive":true,"type":"reference"},{"type":"text","text":" error. If a job handler throws this error the job is re-queued to run at the time specified in the error."}]},{"type":"codeListing","code":["jobService.registerJob(parameters: MyJob.self) { parameters, context in","    guard let resource = getResource(parameters.resourceID) else {","        \/\/ resource isn't ready lets sleep for 30 mins","        throw JobSleep(for: .seconds(30*60))","    }","    try await processResource(resource)","}"],"syntax":"swift"},{"anchor":"Job-Scheduler","type":"heading","level":2,"text":"Job Scheduler"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Jobs framework also comes with a scheduler that allows you to schedule jobs to occur at regular times. You can add a scheduled job using "},{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/JobService\/addScheduledJob(_:schedule:accuracy:)","type":"reference","isActive":true},{"type":"text","text":" from "},{"type":"codeVoice","code":"JobService"},{"type":"text","text":"."}]},{"type":"codeListing","code":["jobService.addScheduledJob(BirthdayRemindersJob(), schedule: .daily(hour: 9))","jobService.addScheduledJob(CleanupStaleSessionDataJob(), schedule: .weekly(day: .sunday, hour: 4))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"JobService"},{"type":"text","text":" is running it will add jobs to the queue at the scheduled times. You need to ensure all your job schedules are defined before running the service. If your job queue driver supports it, it will add background schedule jobs for cleaning up the underlying storage and rescuing orphaned jobs where a server crashed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the "},{"code":"JobService","type":"codeVoice"},{"type":"text","text":" is run on multiple servers the scheduler process will attempt to gain control of the schedule but only one can have control at any time. Once a scheduler has control it keeps control for a defined period. At regular intervals it will keep extending the time it has control. The other schedulers will continue to attempt to claim control. If the scheduler who has control crashes then no longer than the the length of the two time intervals another scheduler will take control. At that point it will attempt to schedule any missed jobs. With this you can ensure the schedule is always running. You can control the length of the time intervals using the scheduler options in the "},{"code":"JobService","type":"codeVoice"},{"type":"text","text":" initializer."}]},{"type":"codeListing","code":["let jobService = JobService(","    .valkey(","        valkeyClient, ","        configuration: .init(queueName: \"MyQueue\"),","        logger: logger","    ),","    logger: logger,","    options: .init(","        scheduler: .init(schedulerLock: .init(.acquire(every: .seconds(60), for: .seconds(70))))","    )",")"],"syntax":"swift"},{"anchor":"Schedule-types","type":"heading","level":3,"text":"Schedule types"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/Schedule","type":"reference"},{"text":" can be setup in a number of ways. It includes functions to trigger once every minute, hour, day, month, week day and functions to trigger on multiple minutes, hours, etc.","type":"text"}]},{"type":"codeListing","code":["jobService.addScheduledJob(TestJobParameters(), schedule: .hourly(minute: 30))","jobService.addScheduledJob(TestJobParameters(), schedule: .yearly(month: 4, date: 1, hour: 8))","jobService.addScheduledJob(TestJobParameters(), schedule: .onMinutes([0,15,30,45]))","jobService.addScheduledJob(TestJobParameters(), schedule: .onDays([.saturday, .sunday], hour: 12, minute: 45))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If these aren’t flexible enough a ","type":"text"},{"type":"codeVoice","code":"Schedule"},{"text":" can be setup using a five value crontab format. Most crontabs are supported but combinations setting both week day and date are not supported.","type":"text"}]},{"type":"codeListing","code":["jobService.addScheduledJob(TestJobParameters(), schedule: .crontab(\"0 12 * * *\")) \/\/ daily at 12 o'clock","jobService.addScheduledJob(TestJobParameters(), schedule: .crontab(\"0 *\/4 * * sat,sun\")) \/\/ every four hours on Saturday and Sunday","jobService.addScheduledJob(TestJobParameters(), schedule: .crontab(\"@daily\")) \/\/ crontab default, every day at midnight "],"syntax":"swift"},{"anchor":"Schedule-accuracy","type":"heading","level":3,"text":"Schedule accuracy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the scheduler hits a point to run a job, it adds it to the job queue. This does mean if the job queue is busy, the scheduled job may not execute at the exact time expected. You can mitigate this by running scheduled jobs on a separate queue or if you are using the Postgres driver you can set the priority for scheduled jobs to be higher."}]},{"type":"paragraph","inlineContent":[{"text":"Also you can setup how accurate you want your scheduler to adhere to the schedule regardless of whether the scheduler is running or not. Obviously if your scheduler is not running it cannot schedule jobs. But you can use the ","type":"text"},{"code":"accuracy","type":"codeVoice"},{"text":" parameter of a schedule to indicate what you want your scheduler to do once it comes back online after having been down.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Setting it to ","type":"text"},{"code":".all","type":"codeVoice"},{"text":" will schedule a job for every trigger point it missed eg if your scheduler was down for 6 hours and you had a hourly schedule it would push a job to the JobQueue for every one of those hours missed. Setting it to ","type":"text"},{"code":".latest","type":"codeVoice"},{"text":" will mean it only schedules a job for last trigger point missed. If you don’t set the value then it will default to ","type":"text"},{"code":".latest","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","code":["jobService.addScheduledJob(","    TestJobParameters(), ","    schedule: .hourly(minute: 30), ","    accuracy: .all",")"],"syntax":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Hummingbird\/JobsGuide"},"references":{"doc://com.opticalaberration.hummingbird/documentation/Jobs/JobRetryStrategy":{"title":"JobRetryStrategy","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"JobRetryStrategy"}],"kind":"symbol","url":"\/documentation\/jobs\/jobretrystrategy","type":"topic","abstract":[{"type":"text","text":"Strategy deciding whether we should retry a failed job and backoff before retrying job"}],"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/JobRetryStrategy","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"JobRetryStrategy"}]},"doc://com.opticalaberration.hummingbird/documentation/JobsValkey":{"abstract":[{"type":"text","text":"Valkey\/Redis implementation for swift-jobs framework"}],"title":"JobsValkey","images":[{"type":"icon","identifier":"logo.png"}],"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsValkey","role":"collection","url":"\/documentation\/jobsvalkey","kind":"symbol","type":"topic"},"doc://com.opticalaberration.hummingbird/documentation/Jobs/Schedule":{"type":"topic","url":"\/documentation\/jobs\/schedule","kind":"symbol","title":"Schedule","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/Schedule","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Schedule"}],"abstract":[{"text":"Generates a Date at regular intervals (hourly, daily, weekly etc)","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Schedule"}]},"doc://com.opticalaberration.hummingbird/documentation/JobsPostgres/PostgresJobQueue":{"type":"topic","url":"\/documentation\/jobspostgres\/postgresjobqueue","kind":"symbol","title":"PostgresJobQueue","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsPostgres\/PostgresJobQueue","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PostgresJobQueue"}],"abstract":[{"type":"text","text":"Postgres Job queue implementation"}],"navigatorTitle":[{"kind":"identifier","text":"PostgresJobQueue"}]},"doc://com.opticalaberration.hummingbird/documentation/Jobs/JobSleep":{"type":"topic","url":"\/documentation\/jobs\/jobsleep","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JobSleep","kind":"identifier"}],"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/JobSleep","kind":"symbol","role":"symbol","title":"JobSleep","abstract":[{"type":"text","text":"Error used to implement custom retry implementations"}],"navigatorTitle":[{"text":"JobSleep","kind":"identifier"}]},"doc://com.opticalaberration.hummingbird/documentation/Jobs/JobQueue/push(_:parameters:options:)":{"title":"push(_:parameters:options:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"push"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Parameters"},{"kind":"text","text":">("},{"preciseIdentifier":"s:4Jobs7JobNameV","kind":"typeIdentifier","text":"JobName"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:4Jobs16JobQueueProtocolPAAE4push_10parameters7options0C0_0B2IDQZAA0B4NameVyqd__G_qd__AG_0B7OptionsQZtYaKSeRd__SERd__s8SendableRd__lF10ParametersL_qd__mfp","kind":"typeIdentifier","text":"Parameters"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"parameters"},{"kind":"text","text":": "},{"preciseIdentifier":"s:4Jobs16JobQueueProtocolPAAE4push_10parameters7options0C0_0B2IDQZAA0B4NameVyqd__G_qd__AG_0B7OptionsQZtYaKSeRd__SERd__s8SendableRd__lF10ParametersL_qd__mfp","kind":"typeIdentifier","text":"Parameters"},{"text":", ","kind":"text"},{"text":"options","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Queue","preciseIdentifier":"s:4Jobs16JobQueueProtocolP0C0Qa","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"JobOptions","preciseIdentifier":"s:4Jobs14JobQueueDriverP0B7OptionsQa","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:4Jobs16JobQueueProtocolP0C0Qa","kind":"typeIdentifier","text":"Queue"},{"kind":"text","text":"."},{"preciseIdentifier":"s:4Jobs14JobQueueDriverP0B2IDQa","kind":"typeIdentifier","text":"JobID"}],"abstract":[{"type":"text","text":"Push Job onto queue"}],"type":"topic","kind":"symbol","url":"\/documentation\/jobs\/jobqueue\/push(_:parameters:options:)","role":"symbol","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/JobQueue\/push(_:parameters:options:)"},"https://github.com/hummingbird-project/swift-jobs":{"title":"swift-jobs","url":"https:\/\/github.com\/hummingbird-project\/swift-jobs","type":"link","identifier":"https:\/\/github.com\/hummingbird-project\/swift-jobs","titleInlineContent":[{"text":"swift-jobs","type":"text"}]},"doc://com.opticalaberration.hummingbird/documentation/Jobs/JobParameters":{"type":"topic","url":"\/documentation\/jobs\/jobparameters","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JobParameters","kind":"identifier"}],"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs\/JobParameters","kind":"symbol","role":"symbol","title":"JobParameters","abstract":[{"type":"text","text":"Defines job parameters and name"}],"navigatorTitle":[{"text":"JobParameters","kind":"identifier"}]},"doc://com.opticalaberration.hummingbird/documentation/JobsValkey/ValkeyJobQueue":{"abstract":[{"type":"text","text":"Valkey implementation of job queue driver"}],"title":"ValkeyJobQueue","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/JobsValkey\/ValkeyJobQueue","role":"symbol","type":"topic","url":"\/documentation\/jobsvalkey\/valkeyjobqueue","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ValkeyJobQueue","kind":"identifier"}],"navigatorTitle":[{"text":"ValkeyJobQueue","kind":"identifier"}]},"doc://com.opticalaberration.hummingbird/documentation/Jobs":{"title":"Jobs","url":"\/documentation\/jobs","role":"collection","abstract":[{"type":"text","text":"Durable job execution. Offload work your server would be doing to another server."}],"type":"topic","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Jobs","kind":"symbol","images":[{"type":"icon","identifier":"logo.png"}]},"doc://com.opticalaberration.hummingbird/documentation/Jobs/JobService/push(_:options:)":{"title":"push(_:options:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"push","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Parameters","kind":"genericPa