uest is authenticated."}]},"doc://com.opticalaberration.hummingbird/documentation/index":{"title":"Hummingbird Documentation","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/index","type":"topic","images":[{"type":"icon","identifier":"logo.png"}],"role":"collection","abstract":[{"type":"text","text":"Documentation for Hummingbird the lightweight, flexible, modern server framework."}],"url":"\/documentation\/index","kind":"article"},"https://github.com/hummingbird-project/hummingbird-auth":{"type":"link","title":"hummingbird-auth","titleInlineContent":[{"type":"text","text":"hummingbird-auth"}],"url":"https:\/\/github.com\/hummingbird-project\/hummingbird-auth","identifier":"https:\/\/github.com\/hummingbird-project\/hummingbird-auth"}}}