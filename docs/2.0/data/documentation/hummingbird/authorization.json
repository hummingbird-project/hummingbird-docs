deVoice","code":"anyOf { }"},{"text":" requires at least one:","type":"text"}]},{"type":"codeListing","code":["\/\/ AND",".add(middleware: AuthorizationPolicyMiddleware(allOf {","    RolePolicy(\"editor\")","    PermissionPolicy(\"posts:publish\")","}))","","\/\/ OR",".add(middleware: AuthorizationPolicyMiddleware(anyOf {","    RolePolicy(\"admin\")","    PermissionPolicy(\"posts:delete\")","}))","","\/\/ NOT",".add(middleware: AuthorizationPolicyMiddleware(Not(RolePolicy(\"banned\"))))","","\/\/ Nested: (admin OR (editor AND posts:publish)) AND NOT banned",".add(middleware: AuthorizationPolicyMiddleware(allOf {","    anyOf {","        RolePolicy(\"admin\")","        allOf { RolePolicy(\"editor\"); PermissionPolicy(\"posts:publish\") }","    }","    Not(RolePolicy(\"banned\"))","}))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"if"},{"type":"text","text":" inside a builder block for conditional policies:"}]},{"type":"codeListing","code":[".add(middleware: AuthorizationPolicyMiddleware(allOf {","    RolePolicy(\"editor\")","    if requiresApproval { PermissionPolicy(\"posts:approved\") }","}))"],"syntax":"swift"},{"anchor":"Customising-the-denial-error","type":"heading","text":"Customising the denial error","level":2},{"type":"paragraph","inlineContent":[{"text":"Pass ","type":"text"},{"code":"deniedError","type":"codeVoice"},{"text":" to override the default ","type":"text"},{"code":"403 Forbidden","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["\/\/ 404 avoids leaking whether the resource exists",".add(middleware: AuthorizationPolicyMiddleware(","    RolePolicy(\"admin\"),","    deniedError: HTTPError(.notFound)","))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"deniedError"},{"text":" accepts any ","type":"text"},{"type":"codeVoice","code":"HTTPResponseError"},{"text":":","type":"text"}]},{"type":"codeListing","code":["struct 