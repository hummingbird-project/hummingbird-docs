":"paragraph","inlineContent":[{"type":"text","text":"For one-off rules use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/HummingbirdAuth\/ClosureAuthorizationPolicy"},{"type":"text","text":":"}]},{"type":"codeListing","code":[".add(middleware: AuthorizationPolicyMiddleware(","    ClosureAuthorizationPolicy { user, request in","        user.id == request.uri.queryParameters.get(\"userId\")","    }","))"],"syntax":"swift"},{"anchor":"Role-based-authorization","type":"heading","text":"Role-based authorization","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Conform your identity type to "},{"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/HummingbirdAuth\/RoleProviding","isActive":true},{"type":"text","text":" to use "},{"type":"reference","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/HummingbirdAuth\/RolePolicy","isActive":true},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The "},{"type":"codeVoice","code":"Roles"},{"type":"text","text":" associated type accepts any "},{"type":"codeVoice","code":"SetAlgebra"},{"type":"text","text":" — "},{"type":"codeVoice","code":"Set<Role>"},{"type":"text","text":", a typed enum,"},{"type":"text","text":" "},{"type":"text","text":"or an "},{"type":"codeVoice","code":"OptionSet"},{"type":"text","text":" for compact bitmask storage:"}]},{"type":"codeListing","code":["\/\/ Set with a typed enum","enum Role: String, Hashable, Sendable { case admin, editor, moderator }","struct User: RoleProviding { var roles: Set<Role> }","","\/\/ OptionSet — single Int32 column, bitwise membership check","struct Role: OptionSet, Sendable {","    let rawValue: Int32","    static let admin  = Role(rawValue: 1 << 0)","    static let editor = Role(rawValue: 1 << 1)","}","struct User: RoleProviding { var roles: Role }"],"syntax":"swift"},{"type":"codeListing","code":[".ad