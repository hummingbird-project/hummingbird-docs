plication","type":"text"}],"role":"article","url":"\/documentation\/hummingbird\/testing","kind":"article","images":[{"identifier":"logo.png","type":"icon"}]},"doc://com.opticalaberration.hummingbird/documentation/Hummingbird/RouterBuilderGuide":{"url":"\/documentation\/hummingbird\/routerbuilderguide","kind":"article","abstract":[{"text":"Building your router using a result builder.","type":"text"}],"images":[{"type":"icon","identifier":"logo.png"}],"type":"topic","identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Hummingbird\/RouterBuilderGuide","role":"article","title":"Result Builder Router"},"doc://com.opticalaberration.hummingbird/documentation/Hummingbird/RequestContexts":{"identifier":"doc:\/\/com.opticalaberration.hummingbird\/documentation\/Hummingbird\/RequestContexts","type":"topic","title":"Request Contexts","abstract":[{"text":"Controlling contextual data provided to middleware and route handlers","type":"text"}],"role":"article","url":"\/documentation\/hummingbird\/requestcontexts","kind":"article","images":[{"identifier":"logo.png","type":"icon"}]}}}